# Copy to .env and fill in real values before deploying anywhere shared.
# A .env with a locally-generated SESSION_SECRET is included for local dev
# so `npm install && npm start` still works with zero setup — generate a new
# one for any real deployment (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`).

PORT=3000
SESSION_SECRET=replace-me-with-a-long-random-string
DATABASE_FILE=./evo360.db

# KNET / Bookey payment gateway — required to make /wallet/topup a real
# charge instead of a simulated credit. Left blank until sandbox
# credentials are issued (see A3 in the hardening checklist).
KNET_MERCHANT_ID=
KNET_API_KEY=
KNET_ENV=sandbox
