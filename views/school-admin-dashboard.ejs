<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
<head>
<%- include('partials/head', { title: t('meta.schoolAdminDashboard.title') }) %>
</head>
<body>
<%- include('partials/adminnav', { admin: admin }) %>

<main class="page" id="main-content">
  <div class="page-head admin-page-head">
    <div>
      <span class="eyebrow"><%= t('schoolAdminDashboard.eyebrow') %></span>
      <h1><%= admin.school %></h1>
      <p><%= t('schoolAdminDashboard.intro') %></p>
    </div>
    <%/* No live update channel exists behind this page, so it carries no
          live indicator — only the truthful label for what it is. */%>
    <span class="live-data-tag"><%= t('schoolAdminDashboard.liveData') %></span>
  </div>

  <div class="grid-3" style="margin-bottom:24px;">
    <div class="stat leaf">
      <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></div>
      <div class="label"><%= t('schoolAdminDashboard.statActiveSubs') %></div>
      <div class="value leaf data-num"><%= activeSubscriptions %></div>
    </div>
    <div class="stat">
      <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8 12 4l8 4-8 4-8-4Z"/><path d="M4 8v8l8 4 8-4V8"/></svg></div>
      <div class="label"><%= t('schoolAdminDashboard.statTodaysMeals') %></div>
      <div class="value data-num"><%= todaysMeals %></div>
    </div>
    <div class="stat">
      <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l2.5 2.5"/></svg></div>
      <div class="label"><%= t(features.showCollection ? 'schoolAdminDashboard.statPendingOrders' : 'schoolAdminDashboard.statPendingWithoutCollection') %></div>
      <div class="value data-num"><%= pendingOrders %></div>
    </div>
  </div>

  <div class="card" style="margin-bottom:24px;">
    <h2 class="dash-section-title" style="margin-bottom:4px;"><%= t('schoolAdminDashboard.trendHeading') %></h2>
    <p style="font-size:12.5px; color:var(--muted); margin-bottom:20px;"><%= t('schoolAdminDashboard.trendIntro') %></p>
    <%/* The bars are decoration over numbers that are already printed
          under each column. The same rows are repeated as a real table
          for anyone reading this with a screen reader, or on a narrow
          screen where a 14-column axis stops being legible — no value
          here depends on hovering a bar. */%>
    <div class="trend-chart" aria-hidden="true">
      <% trend.forEach(t2 => { %>
        <div class="trend-bar-col">
          <div class="trend-bar-track">
            <div class="trend-bar-fill" style="--pct:<%= Math.max(0.03, t2.count / trendMax) %>;"></div>
          </div>
          <span class="trend-bar-count data-num"><%= t2.count %></span>
          <span class="trend-bar-label"><bdi><%= fmtDateShort(t2.date) %></bdi></span>
        </div>
      <% }) %>
    </div>
    <div class="trend-table-wrap">
      <table class="trend-table">
      <caption><%= t('schoolAdminDashboard.trendTableCaption') %></caption>
      <thead>
        <tr><th scope="col"><%= t('schoolAdminDashboard.trendColDate') %></th><th scope="col"><%= t('schoolAdminDashboard.trendColCount') %></th></tr>
      </thead>
      <tbody>
        <% trend.forEach(t2 => { %>
          <tr><th scope="row" class="data-num"><bdi><%= fmtDate(t2.date) %></bdi></th><td class="data-num"><bdi><%= t2.count %></bdi></td></tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2 class="dash-section-title"><%= t('schoolAdminDashboard.recentActivity') %></h2>
    <% if (recentActivity.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/></svg></div>
        <p><strong><%= t('schoolAdminDashboard.emptyTitle') %></strong><%= t('schoolAdminDashboard.emptyBody') %></p>
      </div>
    <% } else { %>
      <div class="responsive-records">
        <div class="data-table-view"><table><thead><tr>
          <% ['colStudent','colMonths','colMealDays','colPaid','colTotal'].forEach(key=>{ %><th><%= t('schoolAdminDashboard.'+key) %></th><% }) %>
        </tr></thead><tbody><% recentActivity.forEach(b=>{ %><tr>
          <td><%= b.student_name %></td><td><%= b.months.map(m=>fmtMonth(m.month,locale)).join(' / ') %></td><td><%= b.meal_days %></td><td><%= fmtDate(b.paid_at) %></td><td><bdi><%= fmtKWD(b.total_kwd) %></bdi></td>
        </tr><% }) %></tbody></table></div>
        <div class="data-card-view"><% recentActivity.forEach(b=>{ %><article class="data-card"><h3><%= b.student_name %></h3><p><%= b.months.map(m=>fmtMonth(m.month,locale)).join(' / ') %></p><dl class="record-details">
          <div><dt><%= t('schoolAdminDashboard.colMealDays') %></dt><dd><%= b.meal_days %></dd></div>
          <div><dt><%= t('schoolAdminDashboard.colPaid') %></dt><dd><%= fmtDate(b.paid_at) %></dd></div>
          <div><dt><%= t('schoolAdminDashboard.colTotal') %></dt><dd><bdi><%= fmtKWD(b.total_kwd) %></bdi></dd></div>
        </dl></article><% }) %></div>
      </div>
    <% } %>
  </div>
</main>

<footer class="app-foot"><%= t('schoolAdminDashboard.footerLine', { count: students.length, unit: t(students.length === 1 ? 'schoolAdminDashboard.footerStudentUnitOne' : 'schoolAdminDashboard.footerStudentUnitOther'), school: admin.school }) %></footer>
</body>
</html>
