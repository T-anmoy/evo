%>
<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Evo Meals — School Meal Management System, Kuwait' }) %>
<meta name="description" content="Evo Meals is Kuwait's digital school meal management system — running the school meal program for schools, parents, students, and catering partners through subscriptions, ordering, tap-to-collect, and real-time reporting.">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Evo Meals",
  "url": "/",
  "description": "Digital school meal management platform connecting schools, parents, students, and catering partners in Kuwait through subscriptions, ordering, tap-to-collect, and real-time reporting.",
  "areaServed": {
    "@type": "Country",
    "name": "Kuwait"
  },
  "email": "info@evo360.tech"
}
</script>
</head>
<body>

<%- include('partials/sitenav', { active: 'home' }) %>

<section class="hero hero-light">
  <div class="wrap-wide hero-inner">
    <div class="hero-copy">
      <span class="eyebrow">For busy parents in Kuwait</span>
      <h1>Real food. Real proof. <em>Every school day.</em></h1>
      <p class="lede">No more hoping lunch got sorted — freshly cooked, delivered to school, with a message the moment your child collects it.</p>
      <div class="hero-actions hero-actions-3">
        <a href="/register" class="btn btn-primary btn-hero-primary" data-magnetic>Order Meals</a>
        <a href="/schools" class="btn btn-outline-lime btn-sm">For Schools</a>
        <a href="/#app" class="btn btn-ghost btn-sm">Download App</a>
      </div>
      <div class="hero-proof">
        <span class="proof-label">Live at</span>
        <div class="schools">
          <span>American Creativity Academy</span>
          <span>Kuwait English School</span>
          <span>The English School</span>
        </div>
      </div>
    </div>
    <div class="hero-media-wrap" data-parallax>
      <div class="hero-media">
        <picture>
          <source media="(max-width:900px)" srcset="/images/hero-mobile.webp" type="image/webp">
          <source media="(max-width:900px)" srcset="/images/hero-mobile.png" type="image/png">
          <source media="(min-width:901px)" srcset="/images/hero-desktop.webp" type="image/webp">
          <source media="(min-width:901px)" srcset="/images/hero-desktop.png" type="image/png">
          <img src="/images/hero-desktop.png" alt="A student opening her Evo Meals box to a freshly cooked hot lunch" fetchpriority="high" decoding="async">
        </picture>
        <span class="hero-media-glow"></span>
      </div>
      <div class="hero-toast" aria-hidden="true">
        <span class="hero-toast-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
        <div>
          <div class="hero-toast-title">Sara tapped in — lunch collected</div>
          <div class="hero-toast-sub">12:04 PM · Arabiatta Chicken Pasta</div>
        </div>
      </div>
    </div>
  </div>
</section>

<% if (SHOW_TRUST_STATS) { %>
<!-- Trust bar: do not fill these with invented numbers. Real figures
     (schools served, students, meals delivered) go here once they exist —
     flip SHOW_TRUST_STATS at the top of this file to bring it back. -->
<section class="trustbar">
  <div class="wrap trustbar-grid">
    <div class="trustbar-item">
      <span class="trustbar-label">Schools</span>
      <span class="trustbar-value trustbar-pending">Figures added at launch</span>
    </div>
    <div class="trustbar-item">
      <span class="trustbar-label">Students</span>
      <span class="trustbar-value trustbar-pending">Figures added at launch</span>
    </div>
    <div class="trustbar-item">
      <span class="trustbar-label">Meals</span>
      <span class="trustbar-value trustbar-pending">Figures added at launch</span>
    </div>
    <div class="trustbar-item">
      <span class="trustbar-label">Technology</span>
      <span class="trustbar-value">Built on real-time tap infrastructure</span>
    </div>
  </div>
</section>
<% } %>

