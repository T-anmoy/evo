<section class="section" id="nutrition">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Nutrition &amp; food safety</span>
      <p class="section-tagline">Freshly Prepared Meals. Seamlessly Delivered.</p>
      <h2>Every dish, checked before it's ever offered.</h2>
      <p>This is a commitment, not a footnote — every meal on the platform is verified against these four allergens before it ever reaches a menu.</p>
    </div>
    <div class="allergen-banner" data-reveal>
      <div class="allergen-banner-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg><span>Nut-free available</span></div>
      <div class="allergen-banner-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg><span>Shellfish-free available</span></div>
      <div class="allergen-banner-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg><span>Sesame-free available</span></div>
      <div class="allergen-banner-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg><span>Soy-free available</span></div>
    </div>
    <div class="grid-4">
      <% menuItems.forEach(m => { %>
        <div class="menu-card" data-reveal data-reveal-group="menu">
          <div class="menu-thumb">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v6M8 8h8l-1 12H9L8 8Z"/></svg>
          </div>
          <div class="menu-card-body">
            <span class="tag"><%= m.tag %></span>
            <h3><%= m.name %></h3>
            <div class="menu-nutri"><span><%= m.calories %> kcal</span><span>·</span><span><%= m.protein %>g protein</span></div>
          </div>
        </div>
      <% }) %>
    </div>
    <p class="nutrition-more" data-reveal>Full ingredients, carbohydrate and fat breakdowns are on every dish's <a href="/menu">menu detail</a>.</p>
  </div>
</section>

<section class="section on-tint" id="dashboard-preview">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="eyebrow">For school administrators</span>
      <h2>See the whole program, in real time.</h2>
