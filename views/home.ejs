<%
/* Content gates — flip to true once real data exists, no rebuild needed.
   Off for now: no real figures (schools/students/meals served) and no real
   testimonials have been collected yet. An omitted section is honest; a
   placeholder or invented number is not. */
const SHOW_TRUST_STATS = false;
%>
<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
<head>
<%- include('partials/head', { title: t('meta.home.title'), description: t('meta.home.description') }) %>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Evo Meals",
  "url": "/",
  "description": "School meal programme connecting schools, parents, students, and catering partners in Kuwait through subscriptions, ordering, tap-to-collect, and real-time reporting.",
  "areaServed": {
    "@type": "Country",
    "name": "Kuwait"
  },
  "email": "info@evo360.tech"
}
</script>
</head>
<body>

<%- include('partials/sitenav', { active: 'home' }) %>

<main id="main-content">
<!-- 4.1 Hero — parent-first -->
<section class="hero hero-light">
  <div class="wrap-wide hero-inner">
    <div class="hero-copy">
      <span class="eyebrow"><%= t('home.hero.eyebrow') %></span>
      <h1><%= t('home.hero.headlinePre') %> <em><%= t('home.hero.headlineEm') %></em></h1>
      <p class="lede"><%= t('home.hero.lede') %></p>
      <div class="hero-actions hero-actions-3">
        <a href="<%= locale === 'ar' ? '/ar/login' : '/login' %>" class="btn btn-outline btn-sm"><%= t('common.login') %></a>
        <a href="<%= locale === 'ar' ? '/ar/register' : '/register' %>" class="btn btn-school-yellow on-light btn-hero-primary" data-magnetic><%= t('common.register') %></a>
        <a href="#supported-schools" class="btn btn-primary"><%= t('home.hero.ctaCheckSchool') %></a>
      </div>
      <a href="<%= locale === 'ar' ? '/ar/how-it-works' : '/how-it-works' %>" class="hero-quiet-link"><%= t('home.hero.ctaHowItWorks') %> <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg></a>
    </div>
    <div class="hero-media-wrap" data-parallax>
      <div class="hero-media">
        <picture>
          <source media="(max-width:900px)" srcset="/images/hero-mobile.webp" type="image/webp">
          <source media="(max-width:900px)" srcset="/images/hero-mobile.png" type="image/png">
          <source media="(min-width:901px)" srcset="/images/hero-desktop.webp" type="image/webp">
          <source media="(min-width:901px)" srcset="/images/hero-desktop.png" type="image/png">
          <img src="/images/hero-desktop.png" alt="<%= t('home.hero.imgAlt') %>" fetchpriority="high" decoding="async">
        </picture>
        <span class="hero-media-glow"></span>
      </div>
      <div class="hero-toast" aria-hidden="true">
        <span class="hero-toast-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
        <div>
          <div class="hero-toast-title"><%= t('home.hero.toastTitle') %></div>
          <div class="hero-toast-sub"><bdi><%= t('home.hero.toastSub') %></bdi></div>
        </div>
      </div>
    </div>
  </div>
</section>

<% if (SHOW_TRUST_STATS) { %>
<!-- Trust bar: do not fill these with invented numbers. Real figures
     (schools served, students, meals delivered) go here once they exist —
     flip SHOW_TRUST_STATS at the top of this file to bring it back. -->
<section class="trustbar">
  <div class="wrap trustbar-grid">
    <div class="trustbar-item">
      <span class="trustbar-label">Schools</span>
      <span class="trustbar-value trustbar-pending">Figures added at launch</span>
    </div>
    <div class="trustbar-item">
      <span class="trustbar-label">Students</span>
      <span class="trustbar-value trustbar-pending">Figures added at launch</span>
    </div>
    <div class="trustbar-item">
      <span class="trustbar-label">Meals</span>
      <span class="trustbar-value trustbar-pending">Figures added at launch</span>
    </div>
  </div>
</section>
<% } %>

<!-- Supported schools — answers the "Check Your School" CTA honestly: a
     plain list of confirmed schools plus a contact path, not an invented
     search engine. School-day calendars for these schools are currently a
     standard-week placeholder (see db.js) pending each school's confirmed
     calendar — the copy below deliberately doesn't claim more than that. -->
<section class="proof-section" id="supported-schools">
  <div class="wrap-wide proof-wrap">
    <div class="proof-intro" data-reveal>
      <span class="eyebrow on-dark"><%= t('home.supportedSchools.eyebrow') %></span>
      <p><%- t('home.supportedSchools.intro', { link: `<a href="/contact" style="color:#fff; text-decoration:underline;">${t('home.supportedSchools.introLink')}</a>` }) %></p>
    </div>
    <ul class="proof-names">
      <li data-reveal data-reveal-group="proof"><span class="proof-name">American Creativity Academy</span><span class="proof-tag"><%= t('home.supportedSchools.tag') %></span></li>
      <li data-reveal data-reveal-group="proof"><span class="proof-name">Kuwait English School</span><span class="proof-tag"><%= t('home.supportedSchools.tag') %></span></li>
      <li data-reveal data-reveal-group="proof"><span class="proof-name">The English School</span><span class="proof-tag"><%= t('home.supportedSchools.tag') %></span></li>
    </ul>
  </div>
</section>

<!-- 4.2 Trust / confidence row — concrete, verifiable capabilities only.
     No physical food-prep claims (e.g. "freshly cooked", "held warm") are
     made here, since that's an operational claim about the catering
     partner's kitchen that this audit has no way to verify. -->
<section class="section" id="confidence">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="eyebrow"><%= t('home.confidence.eyebrow') %></span>
      <h2><%= t('home.confidence.heading') %></h2>
    </div>
    <div class="proof-row" data-reveal>
      <div class="proof-row-item">
        <span class="proof-row-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v6c0 4.4 3.4 8.4 8 9 4.6-.6 8-4.6 8-9V6l-8-3Z"/><path d="m9 12 2 2 4-4"/></svg></span>
        <span><%= t('home.confidence.item1') %></span>
      </div>
      <div class="proof-row-item">
        <span class="proof-row-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></span>
        <span><%= t('home.confidence.item2') %></span>
      </div>
      <div class="proof-row-item">
        <span class="proof-row-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8.5a8 8 0 0 1 12 0M8.5 11a4.5 4.5 0 0 1 7 0M12 14v.01"/></svg></span>
        <span><%= t('home.confidence.item3') %></span>
      </div>
      <div class="proof-row-item">
        <span class="proof-row-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg></span>
        <span><%= t('home.confidence.item4') %></span>
      </div>
    </div>
  </div>
</section>

<!-- 4.3 Food / menu proof -->
<section class="section on-tint" id="menu-proof">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="eyebrow"><%= t('home.menuProof.eyebrow') %></span>
      <h2><%= t('home.menuProof.heading') %></h2>
      <p><%= t('home.menuProof.intro') %></p>
    </div>
    <div class="grid-4">
      <% menuItems.slice(0, 2).forEach(m => { %>
        <div class="menu-card" data-reveal data-reveal-group="menuproof">
          <div class="menu-thumb">
            <%- include('partials/dish-image', { m: m }) %>
          </div>
          <div class="menu-card-body">
            <span class="tag"><%= m.tag %></span>
            <h3><%= m.name %></h3>
            <div class="menu-nutri"><span><bdi><%= m.calories %> <%= t('common.kcal') %></bdi></span><span>·</span><span><bdi><%= m.protein %>g <%= t('common.protein') %></bdi></span></div>
          </div>
        </div>
      <% }) %>
    </div>
    <p class="nutrition-more" data-reveal><%= t('home.menuProof.footnote') %></p>
    <div style="text-align:center; margin-top:24px;">
      <a href="<%= locale === 'ar' ? '/ar/parents' : '/parents' %>#menu" class="btn btn-outline"><%= t('home.menuProof.cta') %></a>
    </div>
  </div>
</section>

<!-- 4.4 Core journey — canonical 6-step flow, shared with /how-it-works so
     this never drifts into a second, differently-worded copy of the same
     sequence. This is the homepage summary; the full explanation (plus
     role-by-role flows) lives on /how-it-works. -->
<%- include('partials/how-it-works-section') %>

<!-- 4.5 Collection proof -->
<section class="section on-cream" id="collection-proof">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="eyebrow"><%= t('home.collectionProof.eyebrow') %></span>
      <h2><%= t('home.collectionProof.heading') %></h2>
      <p><%= t('home.collectionProof.intro') %></p>
    </div>
    <div class="flow-caption">
      <span><%= t('home.collectionProof.flowTap') %></span><span class="flow-caption-arrow" aria-hidden="true">→</span><span><%= t('home.collectionProof.flowCollected') %></span><span class="flow-caption-arrow" aria-hidden="true">→</span><span><%= t('home.collectionProof.flowNotified') %></span>
    </div>
    <div style="text-align:center; margin-bottom:8px;">
      <span class="sample-tag"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg> <%= t('home.collectionProof.sampleTag') %></span>
    </div>
    <div class="parent-flow-demo" aria-hidden="true" data-reveal>
      <div class="tap-demo">
        <div class="tap-card">
          <div class="chip"></div>
          <div class="card-name">Ahmed A.</div>
        </div>
        <div class="tap-reader pulse">
          <div class="ripple"></div>
          <div class="ripple delay"></div>
          <div class="reader-ring">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 8.5a8 8 0 0 1 12 0M8.5 11a4.5 4.5 0 0 1 7 0M12 14v.01"/></svg>
          </div>
          <div class="reader-label">MEAL READER · GATE 2</div>
        </div>
        <div class="tap-toast">
          <div class="toast-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" pathLength="1"><path d="M20 6 9 17l-5-5"/></svg>
          </div>
          <div>
            <div class="toast-title"><%= t('home.collectionProof.toastTitle') %></div>
            <div class="toast-sub"><bdi><%= t('home.collectionProof.toastSub') %></bdi></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 4.6 Multiple children -->
<section class="section" id="multiple-children">
  <div class="wrap what-is-wrap">
    <div data-reveal>
      <span class="eyebrow"><%= t('home.multipleChildren.eyebrow') %></span>
      <h2><%= t('home.multipleChildren.heading') %></h2>
      <p><%= t('home.multipleChildren.intro') %></p>
    </div>
    <div class="card" data-reveal style="max-width:480px;">
      <div class="dash-preview-head" style="padding:0 0 14px;">
        <strong style="font-family:'Montserrat',Arial,sans-serif; font-size:15px; color:var(--forest);"><%= t('home.multipleChildren.cardTitle') %></strong>
        <span class="sample-tag"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg> <%= t('home.multipleChildren.sampleView') %></span>
      </div>
      <div class="student-row">
        <div class="avatar">A</div>
        <div class="student-meta">
          <strong>Ahmed</strong>
          <span><%= t('home.multipleChildren.child1School') %></span>
        </div>
        <span class="status-line ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M20 6 9 17l-5-5"/></svg> <%= t('home.multipleChildren.statusCollected') %></span>
      </div>
      <div class="student-row">
        <div class="avatar">S</div>
        <div class="student-meta">
          <strong>Sara</strong>
          <span><%= t('home.multipleChildren.child2School') %></span>
        </div>
        <span class="status-line pending"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg> <%= t('home.multipleChildren.statusBooked') %></span>
      </div>
    </div>
  </div>
</section>

<!-- 4.7 B2B pathways — concise panels only; the full sales story lives on
     /schools and /caterers, not here. -->
<section class="section on-tint" id="b2b-pathways">
  <div class="wrap">
    <div class="grid-2">
      <div class="benefit-card" data-reveal data-reveal-group="b2b">
        <div class="benefit-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21V9l8-5 8 5v12"/><path d="M9 21v-6h6v6"/></svg></div>
        <h3><%= t('home.b2b.schoolsTitle') %></h3>
        <p><%= t('home.b2b.schoolsBody') %></p>
        <a href="<%= locale === 'ar' ? '/ar/schools' : '/schools' %>" class="btn btn-primary btn-sm"><%= t('home.b2b.schoolsCta') %></a>
      </div>
      <div class="benefit-card" data-reveal data-reveal-group="b2b">
        <div class="benefit-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8 12 4l8 4-8 4-8-4Z"/><path d="M4 8v8l8 4 8-4V8"/></svg></div>
        <h3><%= t('home.b2b.caterersTitle') %></h3>
        <p><%= t('home.b2b.caterersBody') %></p>
        <a href="/caterers" class="btn btn-primary btn-sm"><%= t('home.b2b.caterersCta') %></a>
      </div>
    </div>
  </div>
</section>

<!-- 4.8 App -->
<section class="section" id="app">
  <div class="wrap app-section-wrap">
    <div data-reveal>
      <span class="eyebrow"><%= t('home.app.eyebrow') %></span>
      <h2><%= t('home.app.headingLine1') %><br><%= t('home.app.headingLine2') %></h2>
      <p class="app-flow-intro"><%= t('home.app.flowIntro') %></p>
      <div class="app-steps">
        <div class="app-step">
          <span class="app-step-num">01</span>
          <span class="app-step-label"><%= t('home.app.flowMenu') %></span>
        </div>
        <span class="app-step-connector" aria-hidden="true"></span>
        <div class="app-step">
          <span class="app-step-num">02</span>
          <span class="app-step-label"><%= t('home.app.flowSubscription') %></span>
        </div>
        <span class="app-step-connector" aria-hidden="true"></span>
        <div class="app-step">
          <span class="app-step-num">03</span>
          <span class="app-step-label"><%= t('home.app.flowOrder') %></span>
        </div>
      </div>
      <p class="app-download-cta" style="font-weight:700; margin-bottom:10px;"><%= t('home.app.downloadCta') %></p>
      <div class="store-badges">
        <a href="https://apps.apple.com/us/app/evo-school-meal/id6738001343" class="store-badge" data-magnetic target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zm3.63-3.331c.837-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.817-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701z"/></svg>
          <span><%= t('common.appStore') %></span>
        </a>
        <a href="https://play.google.com/store/apps/details?id=com.pmg.school" class="store-badge" data-magnetic target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zM13.792 12l3.606-3.583L4.24.936A1.5 1.5 0 0 0 3.312.7L13.792 12zM3.24 23.316a1.5 1.5 0 0 0 .928-.235l12.876-7.462-3.604-3.552L3.24 23.316z"/></svg>
          <span><%= t('common.googlePlay') %></span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- 4.9 Short FAQ — conversion-relevant only; see the full FAQ for more -->
<section class="section on-tint" id="faq">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="eyebrow"><%= t('home.faq.eyebrow') %></span>
      <h2><%= t('home.faq.heading') %></h2>
    </div>
    <div class="faq-list">
      <div class="faq-item is-open">
        <button class="faq-summary" type="button" aria-expanded="true"><span><%= t('home.faq.q1') %></span><span class="plus" aria-hidden="true"></span></button>
        <div class="faq-content">
          <div class="faq-answer"><div class="faq-answer-inner"><%= t('home.faq.a1') %></div></div>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-summary" type="button" aria-expanded="false"><span><%= t('home.faq.q2') %></span><span class="plus" aria-hidden="true"></span></button>
        <div class="faq-content">
          <div class="faq-answer"><div class="faq-answer-inner"><%= t('home.faq.a2') %></div></div>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-summary" type="button" aria-expanded="false"><span><%= t('home.faq.q3') %></span><span class="plus" aria-hidden="true"></span></button>
        <div class="faq-content">
          <div class="faq-answer"><div class="faq-answer-inner"><%= t('home.faq.a3') %></div></div>
        </div>
      </div>
      <div class="faq-item">
        <button class="faq-summary" type="button" aria-expanded="false"><span><%= t('home.faq.q4') %></span><span class="plus" aria-hidden="true"></span></button>
        <div class="faq-content">
          <div class="faq-answer"><div class="faq-answer-inner"><%= t('home.faq.a4') %></div></div>
        </div>
      </div>
    </div>
    <p class="nutrition-more" data-reveal><%- t('home.faq.footnote', {
      parents: `<a href="${locale === 'ar' ? '/ar/parents' : '/parents'}">${t('home.faq.footnoteParents')}</a>`,
      features: `<a href="${locale === 'ar' ? '/ar/features' : '/features'}">${t('home.faq.footnoteFeatures')}</a>`
    }) %></p>
  </div>
</section>

<!-- 4.10 Final CTA — separated by intent, not one generic button -->
<section class="cta-band">
  <div class="wrap">
    <div class="section-head" data-reveal style="margin-bottom:32px;">
      <span class="eyebrow on-dark" style="justify-content:center;"><%= t('home.finalCta.eyebrow') %></span>
      <h2 style="margin-top:16px;"><%= t('home.finalCta.heading') %></h2>
    </div>
    <div class="grid-3">
      <div class="benefit-card" data-reveal data-reveal-group="finalcta" style="text-align:center;">
        <h3><%= t('home.finalCta.parentTitle') %></h3>
        <p><%= t('home.finalCta.parentBody') %></p>
        <div class="hero-actions" style="justify-content:center; flex-wrap:wrap;">
          <a href="<%= locale === 'ar' ? '/ar/register' : '/register' %>" class="btn btn-school-yellow btn-sm"><%= t('common.register') %></a>
          <a href="<%= locale === 'ar' ? '/ar/login' : '/login' %>" class="btn btn-outline btn-sm"><%= t('common.login') %></a>
        </div>
      </div>
      <div class="benefit-card" data-reveal data-reveal-group="finalcta" style="text-align:center;">
        <h3><%= t('home.finalCta.schoolTitle') %></h3>
        <p><%= t('home.finalCta.schoolBody') %></p>
        <a href="<%= locale === 'ar' ? '/ar/schools' : '/schools' %>" class="btn btn-primary btn-sm"><%= t('home.finalCta.schoolCta') %></a>
      </div>
      <div class="benefit-card" data-reveal data-reveal-group="finalcta" style="text-align:center;">
        <h3><%= t('home.finalCta.catererTitle') %></h3>
        <p><%= t('home.finalCta.catererBody') %></p>
        <a href="/caterers" class="btn btn-primary btn-sm"><%= t('home.finalCta.catererCta') %></a>
      </div>
    </div>
  </div>
</section>
</main>

<%- include('partials/sitefoot') %>

</body>
</html>
