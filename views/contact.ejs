<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Contact — Evo Meals' }) %>
<meta name="description" content="Get in touch with Evo Meals — whether you're a parent with a question, a school exploring a partnership, or a caterer interested in joining the platform.">
</head>
<body>

<%- include('partials/sitenav', { active: 'contact' }) %>

<section class="hero hero-inner-page">
  <div class="wrap-wide">
    <div class="hero-copy" data-reveal style="max-width:560px;">
      <span class="eyebrow on-dark">Contact</span>
      <h1>Let's talk.</h1>
      <p class="lede">Parent, school, or caterer — tell us a little about what you need and we'll get back to you.</p>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap" style="max-width:560px;">
    <% if (success) { %>
      <div class="alert alert-success"><%- include('partials/success-icon') %><span>Message sent — our team will get back to you shortly.</span></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <div class="card" data-reveal>
      <form method="POST" action="/contact">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label for="contactName">Your name</label>
          <input type="text" id="contactName" name="name" required>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="contactEmail">Email</label>
            <input type="email" id="contactEmail" name="email" inputmode="email" required>
          </div>
          <div class="field">
            <label for="contactRole">I am a...</label>
            <select id="contactRole" name="role">
              <option value="Parent">Parent</option>
              <option value="School">School</option>
              <option value="Caterer">Caterer</option>
              <option value="Other">Other</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="contactMessage">Message</label>
          <textarea id="contactMessage" name="message" rows="5" required placeholder="How can we help?"></textarea>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;">Send message</button>
      </form>
    </div>
  </div>
</section>

<%- include('partials/sitefoot') %>

</body>
</html>
