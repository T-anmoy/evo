<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
<head>
<%- include('partials/head', { title: t('meta.contact.title'), description: t('meta.contact.description') }) %>
</head>
<body>

<%- include('partials/sitenav', { active: 'contact' }) %>

<section class="hero hero-inner-page">
  <div class="wrap-wide">
    <div class="hero-copy" data-reveal style="max-width:640px;">
      <span class="eyebrow on-dark"><%= t('contact.hero.eyebrow') %></span>
      <h1><%= t('contact.hero.heading') %></h1>
      <p class="lede"><%= t('contact.hero.lede') %></p>
    </div>
  </div>
</section>

<section class="section" id="contact-pathways">
  <div class="wrap">
    <div class="grid-3">
      <div class="benefit-card" data-reveal data-reveal-group="contactpaths">
        <div class="benefit-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 9a7 7 0 0 1 14 0"/></svg></div>
        <h3><%= t('contact.pathways.parentTitle') %></h3>
        <p><%= t('contact.pathways.parentBody') %></p>
        <a href="#parent-support" class="btn btn-outline btn-sm"><%= t('contact.pathways.parentCta') %></a>
      </div>
      <div class="benefit-card" data-reveal data-reveal-group="contactpaths">
        <div class="benefit-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21V9l8-5 8 5v12"/><path d="M9 21v-6h6v6"/></svg></div>
        <h3><%= t('contact.pathways.schoolTitle') %></h3>
        <p><%= t('contact.pathways.schoolBody') %></p>
        <a href="<%= locale === 'ar' ? '/ar/schools' : '/schools' %>#partner-form" class="btn btn-outline btn-sm"><%= t('contact.pathways.schoolCta') %></a>
      </div>
      <div class="benefit-card" data-reveal data-reveal-group="contactpaths">
        <div class="benefit-card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8 12 4l8 4-8 4-8-4Z"/><path d="M4 8v8l8 4 8-4V8"/></svg></div>
        <h3><%= t('contact.pathways.catererTitle') %></h3>
        <p><%= t('contact.pathways.catererBody') %></p>
        <a href="<%= locale === 'ar' ? '/ar/caterers' : '/caterers' %>#caterer-form" class="btn btn-outline btn-sm"><%= t('contact.pathways.catererCta') %></a>
      </div>
    </div>
  </div>
</section>

<section class="section on-tint" id="parent-support">
  <div class="wrap" style="max-width:560px;">
    <div class="section-head" data-reveal>
      <span class="eyebrow"><%= t('contact.form.eyebrow') %></span>
      <h2><%= t('contact.form.heading') %></h2>
    </div>
    <% if (success) { %>
      <div class="alert alert-success"><%- include('partials/success-icon') %><span><%= t('contact.form.successMsg') %></span></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <div class="card" data-reveal>
      <% var cv = (typeof values !== 'undefined' && values) ? values : {}; %>
      <form method="POST" action="/contact" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label for="contactName"><%= t('contact.form.labelName') %></label>
          <input type="text" id="contactName" name="name" value="<%= cv.name || '' %>" data-validate="name" required>
          <div class="field-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= t('contact.form.errName') %></span></div>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="contactEmail"><%= t('contact.form.labelEmail') %></label>
            <input type="email" id="contactEmail" name="email" value="<%= cv.email || '' %>" inputmode="email" data-validate="email" required>
            <div class="field-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= t('contact.form.errEmail') %></span></div>
          </div>
          <div class="field">
            <label for="contactRole"><%= t('contact.form.labelRole') %></label>
            <select id="contactRole" name="role">
              <option value="Parent" <%= cv.role === 'Parent' ? 'selected' : '' %>><%= t('contact.form.optParent') %></option>
              <option value="School" <%= cv.role === 'School' ? 'selected' : '' %>><%= t('contact.form.optSchool') %></option>
              <option value="Caterer" <%= cv.role === 'Caterer' ? 'selected' : '' %>><%= t('contact.form.optCaterer') %></option>
              <option value="Other" <%= cv.role === 'Other' ? 'selected' : '' %>><%= t('contact.form.optOther') %></option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="contactMessage"><%= t('contact.form.labelMessage') %></label>
          <textarea id="contactMessage" name="message" rows="5" required minlength="10" maxlength="2000" data-validate="minlength:10" placeholder="<%= t('contact.form.placeholderMessage') %>"><%= cv.message || '' %></textarea>
          <div class="field-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= t('contact.form.errMessage') %></span></div>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;"><%= t('contact.form.submit') %></button>
        <div class="hint hint-secure" style="justify-content:center; margin-top:14px;"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg><span><%= t('contact.form.secureHint') %></span></div>
      </form>
      <p class="nutrition-more" data-reveal style="margin-top:18px;"><%= t('contact.form.footnote') %></p>
    </div>
  </div>
</section>

<%- include('partials/sitefoot') %>

</body>
</html>
