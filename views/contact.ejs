<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
<head>
<%- include('partials/head', { title: t('meta.contact.title'), description: t('meta.contact.description') }) %>
</head>
<body>

<%- include('partials/sitenav', { active: 'contact' }) %>
<main id="main-content" tabindex="-1">

<section class="hero hero-inner-page">
  <div class="wrap-wide">
    <div class="hero-copy" style="max-width:640px;">
      <span class="eyebrow on-dark"><%= t('contact.hero.eyebrow') %></span>
      <h1><%= t('contact.hero.heading') %></h1>
      <p class="lede"><%= t('contact.hero.lede') %></p>
    </div>
  </div>
</section>

<section class="section contact-channels"><div class="wrap contact-channels-inner" data-reveal="up">
  <div><h2><%= t('contact.pathways.parentTitle') %></h2><p><%= t('contact.pathways.parentBody') %></p><div class="action-row"><a href="mailto:info@evo360.tech" class="btn btn-primary"><bdi>info@evo360.tech</bdi></a><a href="https://wa.me/96599570836" class="btn btn-outline"><bdi>WhatsApp · +965 9957 0836</bdi></a></div></div>
  <nav class="contact-role-links"><a href="<%= locale === 'ar' ? '/ar/schools' : '/schools' %>#partner-form"><%= t('contact.pathways.schoolTitle') %> →</a><a href="<%= locale === 'ar' ? '/ar/caterers' : '/caterers' %>#caterer-form"><%= t('contact.pathways.catererTitle') %> →</a></nav>
</div></section>

<section class="section on-tint" id="parent-support">
  <div class="wrap" style="max-width:560px;">
    <div class="section-head" data-reveal-group>
      <span data-reveal="up" class="eyebrow"><%= t('contact.form.eyebrow') %></span>
      <h2 data-reveal="up"><%= t('contact.form.heading') %></h2>
    </div>
    <% if (success) { %>
      <div class="alert alert-success" role="status"><%- include('partials/success-icon') %><span><%= t('contact.form.successMsg') %></span></div>
    <% } %>
    <% if (error) { %>
      <div class="alert alert-error" role="alert"><%= error %></div>
    <% } %>
    <div class="card">
      <% var cv = (typeof values !== 'undefined' && values) ? values : {}; %>
      <% var ce = (typeof errors !== 'undefined' && errors) ? errors : {}; %>
      <form method="POST" action="<%= locale === 'ar' ? '/ar/contact' : '/contact' %>" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field <%= ce.name ? 'invalid' : '' %>">
          <label for="contactName"><%= t('contact.form.labelName') %></label>
          <input type="text" id="contactName" name="name" value="<%= cv.name || '' %>" data-validate="name" required aria-describedby="contactName-error" aria-invalid="<%= (typeof errors !== 'undefined' && errors && errors.name) ? 'true' : 'false' %>">
          <div class="field-error" id="contactName-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= ce.name || t('contact.form.errName') %></span></div>
        </div>
        <div class="form-row">
          <div class="field <%= ce.email ? 'invalid' : '' %>">
            <label for="contactEmail"><%= t('contact.form.labelEmail') %></label>
            <input type="email" id="contactEmail" name="email" value="<%= cv.email || '' %>" inputmode="email" data-validate="email" required aria-describedby="contactEmail-error" aria-invalid="<%= (typeof errors !== 'undefined' && errors && errors.email) ? 'true' : 'false' %>">
            <div class="field-error" id="contactEmail-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= ce.email || t('contact.form.errEmail') %></span></div>
          </div>
          <div class="field">
            <label for="contactRole"><%= t('contact.form.labelRole') %></label>
            <select id="contactRole" name="role">
              <option value="Parent" <%= cv.role === 'Parent' ? 'selected' : '' %>><%= t('contact.form.optParent') %></option>
              <option value="School" <%= cv.role === 'School' ? 'selected' : '' %>><%= t('contact.form.optSchool') %></option>
              <option value="Caterer" <%= cv.role === 'Caterer' ? 'selected' : '' %>><%= t('contact.form.optCaterer') %></option>
              <option value="Other" <%= cv.role === 'Other' ? 'selected' : '' %>><%= t('contact.form.optOther') %></option>
            </select>
          </div>
        </div>
        <div class="field <%= ce.message ? 'invalid' : '' %>">
          <label for="contactMessage"><%= t('contact.form.labelMessage') %></label>
          <textarea id="contactMessage" name="message" rows="5" required minlength="10" maxlength="2000" data-validate="minlength:10" placeholder="<%= t('contact.form.placeholderMessage') %>" aria-describedby="contactMessage-error" aria-invalid="<%= (typeof errors !== 'undefined' && errors && errors.message) ? 'true' : 'false' %>"><%= cv.message || '' %></textarea>
          <div class="field-error" id="contactMessage-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= ce.message || t('contact.form.errMessage') %></span></div>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;"><%= t('contact.form.submit') %></button>
      </form>
      <p class="nutrition-more" style="margin-top:18px;"><%= t('contact.form.footnote') %></p>
    </div>
  </div>
</section>

</main>
<%- include('partials/sitefoot') %>

</body>
</html>
