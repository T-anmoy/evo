<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
<head>
<%- include('partials/head', { title: t('meta.menu.title') }) %>
</head>
<body>
<%- include('partials/appnav', { active: 'menu' }) %>

<main class="page" id="main-content">
  <div class="page-head">
    <span class="eyebrow"><%= t('menu.eyebrow') %></span>
    <h1><%= t('menu.heading') %></h1>
    <p><%= t('menu.intro') %></p>
  </div>

  <% if(!schoolMenus.length){ %><p class="card"><%= t('schoolMenu.prompt') %></p><a href="/students#add-student" class="btn btn-primary"><%= t('students.addButton') %></a><% } %>
  <% schoolMenus.forEach(({school,groups})=>{ %><section class="account-school-menu"><h2><bdi><%= school.name %></bdi></h2><p><%= t('schoolMenu.intro') %></p><%- include('partials/school-menu',{school,groups}) %></section><% }) %>
  <script src="/js/school-menu.js" defer></script>
  <%- include('partials/food-confidence') %>
</main>

<%- include('partials/appfoot') %>
</body>
</html>
