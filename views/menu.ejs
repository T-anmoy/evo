<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
<head>
<%- include('partials/head', { title: t('meta.menu.title') }) %>
</head>
<body>
<%- include('partials/appnav', { active: 'menu' }) %>

<main class="page" id="main-content">
  <div class="page-head">
    <span class="eyebrow"><%= t('menu.eyebrow') %></span>
    <h1><%= t('menu.heading') %></h1>
    <p><%= t('menu.intro') %></p>
  </div>

  <form method="GET" action="/menu" class="school-inline-form" data-account-school-form>
    <div class="field"><label for="account-school"><%= t('schoolMenu.selectTitle') %></label>
      <select id="account-school" name="school" required><option value=""><%= t('schoolMenu.selectTitle') %></option>
        <% schools.forEach(s=>{ %><option value="<%= s.slug %>" <%= selectedSchool?.id===s.id?'selected':'' %>><%= s.name %></option><% }) %>
      </select>
    </div><button class="btn btn-primary"><%= t('schoolMenu.show') %></button>
  </form>
  <% if(selectedSchool){ %><section class="account-school-menu"><h2><bdi><%= selectedSchool.name %></bdi></h2><%- include('partials/school-menu',{school:selectedSchool,groups}) %></section><% } %>
  <script src="/js/school-menu.js?v=<%= assetVersion('js/school-menu.js') %>" defer></script>
  <%- include('partials/food-confidence') %>
</main>

<%- include('partials/appfoot') %>
</body>
</html>
