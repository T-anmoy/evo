<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
<head>
<%- include('partials/head', { title: t('meta.profile.title') }) %>
</head>
<body>
<%- include('partials/appnav', { active: 'profile' }) %>

<main class="page" id="main-content" style="max-width:560px;">
  <div class="page-head">
    <span class="eyebrow"><%= t('profile.eyebrow') %></span>
    <h1><%= t('profile.heading') %></h1>
    <p><%- t('profile.civilIdLine', { civilId: `<strong>${maskCivilId(parent.civilId)}</strong>` }) %></p>
  </div>

  <% if (success) { %><div class="alert alert-success"><%- include('partials/success-icon') %><span><%= t('profile.savedMsg') %></span></div><% } %>

  <div class="card" data-reveal>
    <form method="POST" action="/profile">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="profileName"><%= t('profile.labelName') %></label>
        <input type="text" id="profileName" name="name" value="<%= parent.name %>" required>
      </div>
      <div class="field">
        <label for="profileEmail"><%= t('profile.labelEmail') %></label>
        <input type="email" id="profileEmail" name="email" inputmode="email" value="<%= parent.email %>">
      </div>
      <div class="field">
        <label for="profilePhone"><%= t('profile.labelPhone') %></label>
        <input type="tel" id="profilePhone" name="phone" inputmode="tel" value="<%= parent.phone %>">
      </div>
      <button type="submit" class="btn btn-primary"><%= t('profile.saveChanges') %></button>
    </form>
  </div>
</main>

<%- include('partials/appfoot') %>
</body>
</html>
