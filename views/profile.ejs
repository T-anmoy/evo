<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
<head>
<%- include('partials/head', { title: t('meta.profile.title') }) %>
</head>
<body>
<%- include('partials/appnav', { active: 'profile' }) %>

<main class="page" id="main-content" style="max-width:560px;">
  <div class="page-head">
    <span class="eyebrow"><%= t('profile.eyebrow') %></span>
    <h1><%= t('profile.heading') %></h1>
    <p><%- t('profile.civilIdLine', { civilId: `<strong>${maskCivilId(parent.civilId)}</strong>` }) %></p>
  </div>

  <% if (success) { %><div class="alert alert-success" role="status"><%- include('partials/success-icon') %><span><%= t('profile.savedMsg') %></span></div><% } %>
  <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
  <% var pe = (typeof errors !== 'undefined' && errors) ? errors : {}; %>

  <div class="card">
    <form method="POST" action="/profile" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field <%= pe.name ? 'invalid' : '' %>">
        <label for="profileName"><%= t('profile.labelName') %></label>
        <input type="text" id="profileName" name="name" value="<%= parent.name %>" data-validate="name" required aria-describedby="profileName-error" aria-invalid="<%= (typeof errors !== 'undefined' && errors && errors.name) ? 'true' : 'false' %>">
        <div class="field-error" id="profileName-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= pe.name || t('profile.errName') %></span></div>
      </div>
      <div class="field <%= pe.email ? 'invalid' : '' %>">
        <label for="profileEmail"><%= t('profile.labelEmail') %></label>
        <input type="email" id="profileEmail" name="email" inputmode="email" value="<%= parent.email %>" data-validate="email" aria-describedby="profileEmail-error" aria-invalid="<%= (typeof errors !== 'undefined' && errors && errors.email) ? 'true' : 'false' %>">
        <div class="field-error" id="profileEmail-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= pe.email || t('profile.errEmail') %></span></div>
      </div>
      <div class="field <%= pe.phone ? 'invalid' : '' %>">
        <label for="profilePhone"><%= t('profile.labelPhone') %></label>
        <input type="tel" id="profilePhone" name="phone" inputmode="tel" value="<%= parent.phone %>" data-validate="phone" aria-describedby="profilePhone-error" aria-invalid="<%= (typeof errors !== 'undefined' && errors && errors.phone) ? 'true' : 'false' %>">
        <div class="field-error" id="profilePhone-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= pe.phone || t('profile.errPhone') %></span></div>
      </div>
      <button type="submit" class="btn btn-primary"><%= t('profile.saveChanges') %></button>
    </form>
  </div>
</main>

<%- include('partials/appfoot') %>
</body>
</html>
