<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
<head>
<%- include('partials/head', { title: t('meta.schools.title'), description: t('meta.schools.description') }) %>
</head>
<body>

<%- include('partials/sitenav', { active: 'schools' }) %>

<main id="main-content" tabindex="-1">
<!-- 1. Hero -->
<section class="hero hero-inner-page">
  <div class="wrap-wide">
    <div class="hero-copy" style="max-width:680px;">
      <span class="eyebrow on-dark"><%= t('schools.hero.eyebrow') %></span>
      <h1><%= t('schools.hero.heading') %></h1>
      <p class="lede"><%= t('schools.hero.lede') %></p>
      <div class="hero-actions">
        <a href="#partner-form" class="btn btn-light"><%= t('schools.hero.ctaPartner') %></a>
        <a href="<%= locale === 'ar' ? '/ar/how-it-works' : '/how-it-works' %>" class="btn btn-outline-light"><%= t('schools.hero.ctaHowItWorks') %></a>
      </div>
    </div>
  </div>
</section>

<section class="section"><div class="wrap operational-layout">
  <div class="operational-list" data-reveal-group>
    <% for(let i=1;i<=5;i++){ %><div data-reveal="up"><h2><%= t('schools.operations.title'+i) %></h2><p><%= t('schools.operations.body'+i) %></p></div><% } %>
  </div>
  <div class="card operational-example" data-reveal="fade">
    <span class="sample-tag"><%= t('schools.dashboardPreview.productPreview') %></span>
    <h2><%= t('schools.dashboardPreview.overview') %></h2>
    <p><%= t('schools.dashboardPreview.intro') %></p>
    <dl class="record-details">
      <div><dt><%= t('caterers.orderQueue.colStudent') %></dt><dd><bdi>Ahmed A.</bdi></dd></div>
      <div><dt><%= t('caterers.orderQueue.colMeal') %></dt><dd><bdi>Arabiatta Chicken Pasta</bdi></dd></div>
      <div><dt><%= t('caterers.orderQueue.colStatus') %></dt><dd><%- include('partials/example-status',{status:'Upcoming'}) %></dd></div>
    </dl>
    <a href="/school-admin/login" class="btn btn-outline"><%= t('meta.schoolAdminLogin.title') %></a>
    <a class="food-book-link" href="<%= locale === 'ar' ? '/ar/parents' : '/parents' %>"><%= t('schools.parentExperience.cta') %> →</a>
  </div>
</div></section>
<section class="section on-tint" id="partner-form">
  <div class="wrap partner-form-wrap">
    <div class="section-head" data-reveal-group style="margin:0 0 0;">
      <span data-reveal="up" class="eyebrow"><%= t('schools.partnerForm.eyebrow') %></span>
      <h2 data-reveal="up"><%= t('schools.partnerForm.heading') %></h2>
      <p data-reveal="up"><%= t('schools.partnerForm.intro') %></p>
    </div>
    <div class="card">
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success" role="status"><%- include('partials/success-icon') %><span><%= t('schools.partnerForm.successMsg') %></span></div>
      <% } else { %>
        <% var fd = (typeof formData !== 'undefined' && formData) ? formData : {}; var errs = (typeof errors !== 'undefined' && errors) ? errors : {}; %>
        <form method="POST" action="<%= locale === 'ar' ? '/ar/schools/inquiry' : '/schools/inquiry' %>" id="schoolInquiryForm" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field <%= errs.organizationName ? 'invalid' : '' %>">
            <label for="schoolOrgName"><%= t('schools.partnerForm.labelSchoolName') %></label>
            <input type="text" id="schoolOrgName" name="organizationName" value="<%= fd.organizationName || '' %>" required data-validate="required" aria-describedby="schoolOrgName-error" aria-invalid="<%= (typeof errors !== 'undefined' && errors && errors.organizationName) ? 'true' : 'false' %>">
            <div class="field-error" id="schoolOrgName-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= errs.organizationName || t('schools.partnerForm.errSchoolName') %></span></div>
          </div>
          <div class="form-row">
            <div class="field <%= errs.contactName ? 'invalid' : '' %>">
              <label for="schoolContactName"><%= t('schools.partnerForm.labelContactName') %></label>
              <input type="text" id="schoolContactName" name="contactName" value="<%= fd.contactName || '' %>" required data-validate="name" aria-describedby="schoolContactName-error" aria-invalid="<%= (typeof errors !== 'undefined' && errors && errors.contactName) ? 'true' : 'false' %>">
              <div class="field-error" id="schoolContactName-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= errs.contactName || t('schools.partnerForm.errContactName') %></span></div>
            </div>
            <div class="field">
              <label for="schoolContactRole"><%= t('schools.partnerForm.labelContactRole') %></label>
              <input type="text" id="schoolContactRole" name="contactRole" value="<%= fd.contactRole || '' %>" placeholder="<%= t('schools.partnerForm.placeholderContactRole') %>">
            </div>
          </div>
          <div class="form-row">
            <div class="field <%= errs.email ? 'invalid' : '' %>">
              <label for="schoolContactEmail"><%= t('schools.partnerForm.labelEmail') %></label>
              <input type="email" id="schoolContactEmail" name="email" value="<%= fd.email || '' %>" inputmode="email" required data-validate="email" aria-describedby="schoolContactEmail-error" aria-invalid="<%= (typeof errors !== 'undefined' && errors && errors.email) ? 'true' : 'false' %>">
              <div class="field-error" id="schoolContactEmail-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= errs.email || t('schools.partnerForm.errEmail') %></span></div>
            </div>
            <div class="field <%= errs.phone ? 'invalid' : '' %>">
              <label for="schoolContactPhone"><%= t('schools.partnerForm.labelPhone') %></label>
              <input type="tel" id="schoolContactPhone" name="phone" value="<%= fd.phone || '' %>" inputmode="tel" data-validate="phone" placeholder="+965 ..." aria-describedby="schoolContactPhone-error" aria-invalid="<%= (typeof errors !== 'undefined' && errors && errors.phone) ? 'true' : 'false' %>">
              <div class="field-error" id="schoolContactPhone-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= errs.phone || t('schools.partnerForm.errPhone') %></span></div>
            </div>
          </div>
          <div class="form-row">
            <div class="field">
              <label for="schoolScale"><%= t('schools.partnerForm.labelStudentCount') %></label>
              <select id="schoolScale" name="scaleInfo">
                <option value="Under 200" <%= fd.scaleInfo === 'Under 200' ? 'selected' : '' %>><%= t('schools.partnerForm.optUnder200') %></option>
                <option value="200–500" <%= fd.scaleInfo === '200–500' ? 'selected' : '' %>><%= t('schools.partnerForm.opt200to500') %></option>
                <option value="500–1,000" <%= fd.scaleInfo === '500–1,000' ? 'selected' : '' %>><%= t('schools.partnerForm.opt500to1000') %></option>
                <option value="1,000+" <%= fd.scaleInfo === '1,000+' ? 'selected' : '' %>><%= t('schools.partnerForm.opt1000plus') %></option>
              </select>
            </div>
            <div class="field">
              <label for="schoolArrangement"><%= t('schools.partnerForm.labelCurrentArrangement') %></label>
              <select id="schoolArrangement" name="currentArrangement">
                <option value="No formal program" <%= fd.currentArrangement === 'No formal program' ? 'selected' : '' %>><%= t('schools.partnerForm.optNoFormal') %></option>
                <option value="Informal caterer arrangement" <%= fd.currentArrangement === 'Informal caterer arrangement' ? 'selected' : '' %>><%= t('schools.partnerForm.optInformal') %></option>
                <option value="Existing digital system" <%= fd.currentArrangement === 'Existing digital system' ? 'selected' : '' %>><%= t('schools.partnerForm.optExisting') %></option>
                <option value="Other" <%= fd.currentArrangement === 'Other' ? 'selected' : '' %>><%= t('schools.partnerForm.optOther') %></option>
              </select>
            </div>
          </div>
          <div class="field <%= errs.message ? 'invalid' : '' %>">
            <label for="schoolMessage"><%= t('schools.partnerForm.labelMessage') %></label>
            <textarea id="schoolMessage" name="message" rows="4" required maxlength="2000" data-validate="minlength:10" placeholder="<%= t('schools.partnerForm.placeholderMessage') %>" aria-describedby="schoolMessage-error" aria-invalid="<%= (typeof errors !== 'undefined' && errors && errors.message) ? 'true' : 'false' %>"><%= fd.message || '' %></textarea>
            <div class="field-error" id="schoolMessage-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= errs.message || t('schools.partnerForm.errMessage') %></span></div>
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%;"><%= t('schools.partnerForm.submit') %></button>
        </form>
      <% } %>
    </div>
  </div>
</section>


</main>

<%- include('partials/sitefoot') %>

</body>
</html>
