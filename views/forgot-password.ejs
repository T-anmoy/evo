<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Forgot password — Evo Meals' }) %>
</head>
<body>
  <div class="auth-shell">
    <div class="auth-card">
      <div class="logo"><span>Evo <span class="dot">Meals</span></span></div>
      <h1>Reset your password</h1>
      <p class="sub">Enter the Civil ID or email on your account and we'll send you instructions.</p>

      <% if (submitted) { %>
        <div class="alert alert-success"><%- include('partials/success-icon') %><span>If an account exists, we've sent instructions.</span></div>
      <% } else { %>
        <p class="hint" style="margin-bottom:18px;">This is a simulated flow for now — no real email is sent yet.</p>
        <form method="POST" action="/forgot-password" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field">
            <label for="identifier">Civil ID or email</label>
            <input type="text" id="identifier" name="identifier" placeholder="Civil ID or email" autocomplete="username" data-validate="civilid-or-email" required autofocus>
            <div class="field-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span>Enter a valid Civil ID (12 digits) or email address.</span></div>
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%;">Send instructions</button>
        </form>
      <% } %>

      <div class="auth-foot"><a href="/login" style="color:var(--lime-700); font-weight:600;">Back to log in</a></div>
    </div>
  </div>
</body>
</html>
