<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
<head>
<%- include('partials/head', { title: t('meta.forgotPassword.title'), description: t('meta.forgotPassword.description') }) %>
</head>
<body>
  <main id="main-content" class="auth-shell">
    <div class="auth-card">
      <%- include('partials/auth-nav') %>
      <div class="logo"><span>Evo <span class="dot">Meals</span></span></div>
      <h1><%= t('forgotPassword.title') %></h1>
      <p class="sub"><%= t('forgotPassword.subtitle') %></p>

      <p class="hint"><%= t('forgotPassword.simulatedHint') %> <a href="<%= locale === 'ar' ? '/ar/contact' : '/contact' %>"><%= t('nav.contact') %></a></p>
      <% if (submitted) { %>
        <div class="alert alert-success" role="status"><%- include('partials/success-icon') %><span><%= t('forgotPassword.successMsg') %></span></div>
      <% } else { %>
        <% var fe = (typeof errors !== 'undefined' && errors) ? errors : {}; %>
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="alert alert-error" role="alert"><%= error %></div>
        <% } %>
        <form method="POST" action="<%= locale === 'ar' ? '/ar/forgot-password' : '/forgot-password' %>" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field <%= fe.identifier ? 'invalid' : '' %>">
            <label for="identifier"><%= t('forgotPassword.labelIdentifier') %></label>
            <input type="text" id="identifier" name="identifier" value="<%= typeof identifier !== 'undefined' && identifier ? identifier : '' %>" placeholder="<%= t('forgotPassword.placeholderIdentifier') %>" autocomplete="username" data-validate="civilid-or-email" required aria-describedby="identifier-error" aria-invalid="<%= (typeof errors !== 'undefined' && errors && errors.identifier) ? 'true' : 'false' %>">
            <div class="field-error" id="identifier-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= fe.identifier || t('forgotPassword.errIdentifier') %></span></div>
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%;"><%= t('forgotPassword.submit') %></button>
        </form>
      <% } %>

      <div class="auth-foot"><a href="<%= locale === 'ar' ? '/ar/login' : '/login' %>" style="color:var(--leaf-dark); font-weight:600;"><%= t('forgotPassword.backToLogin') %></a></div>
    </div>
  </main>
</body>
</html>
