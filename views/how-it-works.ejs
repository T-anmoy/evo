<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
<head>
<%- include('partials/head', { title: t('meta.howItWorks.title'), description: t('meta.howItWorks.description') }) %>
</head>
<body>

<%- include('partials/sitenav', { active: 'how-it-works' }) %>

<main id="main-content" tabindex="-1">
<section class="hero hero-inner-page">
  <div class="wrap-wide">
    <div class="hero-copy" style="max-width:680px;">
      <span class="eyebrow on-dark"><%= t('howItWorks.hero.eyebrow') %></span>
      <h1><%= t('howItWorks.hero.heading') %></h1>
      <p class="lede"><%= t('howItWorks.hero.lede') %></p>
    </div>
  </div>
</section>

<section class="section"><div class="wrap">
  <ol class="parent-journey journey-three" data-reveal="sequence">
    <% for(let step=1;step<=3;step++){ %>
      <li class="journey-item">
        <span class="journey-label"><bdi class="journey-number">0<%= step %></bdi></span>
        <h2><%= t('howItWorks.steps.title'+step) %></h2>
        <p><%= t('howItWorks.steps.body'+step) %></p>
      </li>
    <% } %>
  </ol>
</div></section>
<%- include('partials/features-section') %>

<section class="cta-band">
  <div class="wrap" style="text-align:center;" data-reveal-group>
    <span data-reveal="up" class="eyebrow on-dark" style="justify-content:center;"><%= t('howItWorks.cta.eyebrow') %></span>
    <h2 data-reveal="up" style="margin-top:16px;"><%= t('howItWorks.cta.heading') %></h2>
    <p data-reveal="up" style="margin:14px auto 28px;"><%= t('howItWorks.cta.body') %></p>
    <a href="<%= locale === 'ar' ? '/ar/register' : '/register' %>" class="btn btn-school-yellow"><%= t('common.createAccount') %></a>
  </div>
</section>
</main>

<%- include('partials/sitefoot') %>

</body>
</html>
