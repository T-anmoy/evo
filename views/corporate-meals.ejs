<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
<head>
<%- include('partials/head', { title: t('meta.corporate.title'), description: t('meta.corporate.description') }) %>
</head>
<body>

<%- include('partials/sitenav', { active: 'corporate' }) %>
<main id="main-content" tabindex="-1">

<!-- 1. Hero -->
<section class="hero hero-inner-page">
  <div class="wrap-wide">
    <div class="hero-copy" style="max-width:640px;">
      <span class="eyebrow on-dark"><%= t('corporate.hero.eyebrow') %></span>
      <h1><%= t('corporate.hero.heading') %></h1>
      <p class="lede"><%= t('corporate.hero.lede') %></p>
      <div class="hero-actions">
        <a href="<%= locale === 'ar' ? '/ar' : '' %>/corporate-meals/register" class="btn btn-light"><%= t('corporate.hero.cta') %></a>
      <a href="#corporate-menu" class="btn btn-outline-light"><%= t('corporate.menuHeading') %></a>
      </div>
    </div>
  </div>
</section>

<section class="section"><div class="wrap">
  <ul class="checklist"><% for(let i=1;i<=3;i++){ %><li><%= t('corporate.point'+i) %></li><% } %></ul>
  <a href="<%= locale === 'ar' ? '/ar' : '' %>/how-it-works" class="btn btn-outline"><%= t('corporate.howBookingWorks') %></a>
  <p class="hint"><%= t('corporate.simulated') %></p>
</div></section>

<section class="section on-tint" id="corporate-menu"><div class="wrap">
  <div class="section-head"><h2><%= t('corporate.menuHeading') %></h2></div>
  <%- include('partials/school-menu', {school: {id: 'corporate'}, groups, corporateMenu: true}) %>
</div></section>

</main>
<%- include('partials/sitefoot') %>

</body>
</html>
