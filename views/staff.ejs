<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
<head>
<%- include('partials/head', { title: t('meta.staff.title') }) %>
</head>
<body>
<%- include('partials/appnav', { active: 'staff' }) %>

<main class="page" id="main-content" style="max-width:640px;">
  <div class="page-head">
    <span class="eyebrow"><%= t('staff.eyebrow') %></span>
    <h1><%= t('staff.heading') %></h1>
    <p><%= t('staff.intro') %></p>
    <p class="scope-note"><%= t('staff.scopeNote') %></p>
  </div>

  <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
  <% if (success) { %><div class="alert alert-success" role="status"><%= t('staff.successMsg') %></div><% } %>
  <div class="card">
    <form method="POST" action="/staff">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="staffMeal"><%= t('staff.labelMeal') %></label>
        <select id="staffMeal" name="menuItemId" required>
          <%/* The same menu_items rows the parent booking flow reads —
                there is no second, hardcoded staff dish list to drift. */%>
          <% menuItems.forEach(m => { %><option value="<%= m.id %>" <%= String(m.id) === values.menuItemId ? 'selected' : '' %>><%= m.name %></option><% }) %>
        </select>
      </div>
      <div class="field">
        <label for="staffDate"><%= t('staff.labelDate') %></label>
        <input id="staffDate" type="date" name="startDate" min="<%= bookingWindow().today %>" max="<%= bookingWindow().horizon %>" value="<%= values.startDate || bookingWindow().today %>" required>
      </div>
      <div class="confirm-bar" style="flex-direction:row; justify-content:space-between; align-items:center;">
        <span style="color:rgba(255,255,255,0.65); font-size:13px; font-weight:500;"><%= t('staff.priceLabel') %></span>
        <strong class="data-num" style="color:var(--leaf-light); font-size:18px;"><bdi><%= fmtKWD(dailyRateKWD) %></bdi></strong>
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;"><%= t('staff.submit') %></button>
    </form>
  </div>

  <div class="card">
    <h2 class="dash-section-title"><%= t('staff.yourBookings') %></h2>
    <% if (bookings.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/></svg></div>
        <p><strong><%= t('staff.emptyTitle') %></strong><%= t('staff.emptyBody') %></p>
      </div>
    <% } else { %>
      <table class="staff-records">
        <thead>
          <tr>
            <th scope="col"><%= t('staff.colMeal') %></th>
            <th scope="col"><%= t('staff.colDate') %></th>
            <th scope="col"><%= t('staff.colTotal') %></th>
            <th scope="col"><%= t('staff.colStatus') %></th>
          </tr>
        </thead>
        <tbody>
          <% bookings.forEach(b => { %>
            <tr>
              <td lang="en" dir="auto"><%= b.menuItem ? b.menuItem.name : '—' %></td>
              <td class="data-num"><bdi><%= fmtDate(b.startDate) %></bdi></td>
              <td class="data-num"><bdi><%= fmtKWD(b.totalKWD) %></bdi></td>
              <td>
                <% if (b.status === 'collected') { %><span class="badge badge-collected"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M20 6 9 17l-5-5"/></svg> <%= t('staff.statusCollected') %></span>
                <% } else if (b.status === 'cancelled') { %><span class="badge badge-cancelled"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg> <%= t('staff.statusCancelled') %></span>
                <% } else { %><span class="badge badge-upcoming"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg> <%= t('staff.statusBooked') %></span><% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</main>

<%- include('partials/appfoot') %>
</body>
</html>
