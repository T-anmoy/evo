<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Wallet — Evo Meals' }) %>
</head>
<body>
<%- include('partials/appnav', { active: 'wallet' }) %>

<div class="page">
  <div class="page-head">
    <span class="eyebrow">Your wallet</span>
    <h1>Balance &amp; transaction history</h1>
    <p>This entire page didn't exist in the earlier system — wallet visibility was one of the biggest gaps found in the audit.</p>
  </div>

  <% if (success) { %><div class="alert alert-success"><%- include('partials/success-icon') %><span>Topped up — your new balance is ready to book with.</span></div><% } %>
  <% if (lowbalance) { %><div class="alert alert-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span>Your balance isn't enough to renew that plan — top up below, then try renewing again from your dashboard.</span></div><% } %>

  <div class="grid-2" style="align-items:start;">
    <div class="card" style="text-align:center;" data-reveal>
      <div style="font-size:12px; color:var(--muted); margin-bottom:8px; text-transform:uppercase; letter-spacing:0.05em; font-weight:600;">Current balance</div>
      <div class="data-num" style="font-size:38px; color:var(--lime-700); margin-bottom:20px;" data-countup="<%= fmtKWD(wallet.balanceKWD) %>">KWD 0.000</div>
      <form method="POST" action="/wallet/topup">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label for="topupAmount">Top up amount (KWD)</label>
          <input type="number" name="amount" id="topupAmount" step="0.5" min="1" value="10" required>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;">Top up with KNET</button>
        <div class="hint" style="text-align:center; margin-top:8px;">KNET is Kuwait's national payment network — the same one your bank card already uses. Demo only here, no real payment is processed.</div>
      </form>
    </div>

    <div class="card" data-reveal>
      <h3 style="font-size:15px; margin-bottom:16px;">Recent transactions</h3>
      <% if (transactions.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="13" rx="2"/><path d="M3 10h18M7 15h4"/></svg></div>
          <p><strong>No transactions yet</strong>Top up your wallet to get started — every top-up and booking will show up here.</p>
        </div>
      <% } else { %>
        <div class="data-table-view">
          <table>
            <tbody>
              <% transactions.forEach(t => { %>
                <tr>
                  <td>
                    <strong style="display:block; font-size:13px;"><%= t.note %></strong>
                    <span class="data-num" style="font-size:11.5px; color:var(--muted); font-weight:500;"><%= fmtDate(t.createdAt) %></span>
                  </td>
                  <td class="data-num" style="text-align:right; font-size:14px; color:<%= t.amountKWD >= 0 ? 'var(--lime-700)' : 'var(--red-500)' %>;">
                    <%= t.amountKWD >= 0 ? '+' : '' %><%= fmtKWD(t.amountKWD) %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <div class="data-card-view">
          <% transactions.forEach(t => { %>
            <div class="data-card">
              <div class="data-card-head">
                <div>
                  <strong style="font-size:13.5px;"><%= t.note %></strong>
                  <span class="data-num"><%= fmtDate(t.createdAt) %></span>
                </div>
                <span class="data-num" style="font-size:15px; color:<%= t.amountKWD >= 0 ? 'var(--lime-700)' : 'var(--red-500)' %>; flex-shrink:0;">
                  <%= t.amountKWD >= 0 ? '+' : '' %><%= fmtKWD(t.amountKWD) %>
                </span>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</div>

</body>
</html>
