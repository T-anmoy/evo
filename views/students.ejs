<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
<head>
<%- include('partials/head', { title: t('meta.students.title') }) %>
</head>
<body>
<%- include('partials/appnav', { active: 'students' }) %>

<main class="page" id="main-content">
  <div class="page-head">
    <span class="eyebrow"><%= t('students.eyebrow') %></span>
    <h1><%= t('students.heading') %></h1>
    <p><%= t('students.intro') %></p>
  </div>

  <%
     /* Existing children lead once there are any: a returning parent's
        task is "manage the child I already registered", not "fill in a
        new one". The form stays fully open for the first child and for an
        edit in progress — the two cases where it IS the task. */
     const showFormExpanded = !students.length || !!editing;
  %>
  <div class="students-layout<%= showFormExpanded ? '' : ' students-layout--stacked' %>">
    <div class="card">
      <h2 class="dash-section-title"><%= t('students.allStudents') %></h2>
      <% if (students.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 9a7 7 0 0 1 14 0"/></svg></div>
          <p><strong><%= t('students.emptyTitle') %></strong><%= t('students.emptyBody') %></p>
        </div>
      <% } else { %>
        <% students.forEach(s => { %>
          <div class="student-row">
            <div class="avatar"><%= s.name.charAt(0) %></div>
            <div class="student-meta">
              <strong><%= s.name %></strong><% if (s.allergies) { %><details class="student-notes"><summary><%= t('students.hasAllergiesLabel') %></summary><p><%= s.allergies %></p><small><%= t('students.hintAllergies') %></small></details><% } %>
              <span><%= s.school %> · <%= s.class %><%= s.section ? '-' + s.section : '' %> · ID <bdi><%= maskCivilId(s.civilId) %></bdi></span>
            </div>
            <a href="/students/<%= s.id %>/edit" class="btn btn-outline btn-sm"><%= t('students.edit') %></a>
          </div>
        <% }) %>
      <% } %>
    </div>
    <% if (showFormExpanded) { %>
      <div class="card">
        <h2 class="dash-section-title"><%= editing ? t('students.editTitle') : t('students.addTitle') %></h2>
<%- include('partials/student-form') %>      </div>
    <% } else { %>
      <details class="card add-student-disclosure" id="add-student">
        <summary>
          <strong><%= t('students.addAnotherTitle') %></strong>
          <span><%= t('students.addAnotherHint') %></span>
        </summary>
        <div class="add-student-form">
<%- include('partials/student-form') %>        </div>
      </details>
    <% } %>
  </div>
</main>

<%- include('partials/appfoot') %>
</body>
</html>
