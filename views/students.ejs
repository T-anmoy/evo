<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
<head>
<%- include('partials/head', { title: t('meta.students.title') }) %>
</head>
<body>
<%- include('partials/appnav', { active: 'students' }) %>

<main class="page" id="main-content">
  <div class="page-head">
    <span class="eyebrow"><%= t('students.eyebrow') %></span>
    <h1><%= t('students.heading') %></h1>
    <p><%= t('students.intro') %></p>
  </div>

  <div class="grid-2">
    <div class="card">
      <h3 style="font-size:15px; margin-bottom:16px;"><%= editing ? t('students.editTitle') : t('students.addTitle') %></h3>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <form method="POST" action="/students" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (editing) { %><input type="hidden" name="id" value="<%= editing.id %>"><% } %>
        <div class="form-row">
          <div class="field">
            <label><%= t('students.labelName') %></label>
            <input type="text" name="name" value="<%= editing ? editing.name : '' %>" data-validate="name" maxlength="60" required>
            <div class="field-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= t('students.errName') %></span></div>
          </div>
          <div class="field">
            <label for="studentCivilId"><%= t('students.labelCivilId') %></label>
            <% if (editing) { %>
              <input type="text" id="studentCivilId" value="<%= maskCivilId(editing.civilId) %>" disabled>
              <div class="hint"><%= t('students.hintCivilIdEditing') %></div>
            <% } else { %>
              <input type="text" id="studentCivilId" name="civilId" value="" placeholder="<%= t('students.placeholderCivilId') %>" inputmode="numeric" maxlength="12" pattern="\d{12}" data-validate="civilid" required aria-describedby="studentCivilIdHint">
              <div class="hint" id="studentCivilIdHint"><%= t('students.hintCivilIdNew') %></div>
              <div class="field-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= t('students.errCivilId') %></span></div>
            <% } %>
          </div>
        </div>
        <% // Siblings are commonly at the same school — default the field to
           // whichever school the most recently added child is at, so a
           // second (or third) child is a one-tap confirm instead of a
           // reselect from scratch.
           const lastStudent = students.length ? students.reduce((a, b) => (b.id > a.id ? b : a)) : null;
           const defaultSchool = editing ? editing.school : (lastStudent ? lastStudent.school : null);
        %>
        <div class="field">
          <label><%= t('students.labelSchool') %></label>
          <select name="school" required>
            <% ['Kuwait English School','American Creativity Academy','The English School'].forEach(s => { %>
              <option value="<%= s %>" <%= defaultSchool === s ? 'selected' : '' %>><%= s %></option>
            <% }) %>
          </select>
          <% if (!editing && lastStudent) { %><div class="hint"><%= t('students.hintDefaultSchool', { name: lastStudent.name }) %></div><% } %>
        </div>
        <div class="form-row">
          <div class="field">
            <label><%= t('students.labelClass') %></label>
            <input type="text" name="class" value="<%= editing ? editing.class : '' %>" placeholder="<%= t('students.placeholderClass') %>">
          </div>
          <div class="field">
            <label><%= t('students.labelSection') %></label>
            <input type="text" name="section" value="<%= editing ? editing.section : '' %>" placeholder="<%= t('students.placeholderSection') %>">
          </div>
        </div>
        <div class="field">
          <label><%= t('students.labelGender') %></label>
          <select name="gender">
            <option <%= editing && editing.gender === 'Male' ? 'selected' : '' %> value="Male"><%= t('students.male') %></option>
            <option <%= editing && editing.gender === 'Female' ? 'selected' : '' %> value="Female"><%= t('students.female') %></option>
          </select>
        </div>
        <div class="field">
          <label><%= t('students.labelAllergies') %></label>
          <input type="text" name="allergies" value="<%= editing ? editing.allergies : '' %>" placeholder="<%= t('students.placeholderAllergies') %>">
          <div class="hint"><%= t('students.hintAllergies') %></div>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;"><%= editing ? t('students.saveChanges') : t('students.addStudent') %></button>
        <% if (editing) { %><a href="/students" class="btn btn-ghost" style="width:100%; margin-top:8px;"><%= t('students.cancel') %></a><% } %>
      </form>
    </div>

    <div class="card">
      <h3 style="font-size:15px; margin-bottom:16px;"><%= t('students.allStudents') %></h3>
      <% if (students.length === 0) { %>
        <div class="empty-state">
          <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 9a7 7 0 0 1 14 0"/></svg></div>
          <p><strong><%= t('students.emptyTitle') %></strong><%= t('students.emptyBody') %></p>
        </div>
      <% } else { %>
        <% students.forEach(s => { %>
          <div class="student-row">
            <div class="avatar"><%= s.name.charAt(0) %></div>
            <div class="student-meta">
              <strong><%= s.name %><% if (s.allergies) { %><span class="allergy-flag" title="<%= t('students.allergiesTitle', { allergies: s.allergies }) %>" aria-label="<%= t('students.hasAllergiesLabel') %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4 6v6c0 4.4 3.4 8.4 8 9 4.6-.6 8-4.6 8-9V6l-8-3Z"/><path d="m9 12 2 2 4-4"/></svg></span><% } %></strong>
              <span><%= s.school %> · <%= s.class %><%= s.section ? '-' + s.section : '' %> · ID <%= maskCivilId(s.civilId) %></span>
            </div>
            <a href="/students/<%= s.id %>/edit" class="btn btn-outline btn-sm"><%= t('students.edit') %></a>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</main>

<%- include('partials/appfoot') %>
</body>
</html>
