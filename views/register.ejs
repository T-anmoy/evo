<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
<head>
<%- include('partials/head', { title: t('meta.register.title') }) %>
</head>
<body>
  <main class="auth-shell">
    <div class="auth-card" style="max-width:460px;">
      <div class="logo"><span>Evo <span class="dot">Meals</span></span></div>
      <h1><%= t('register.title') %></h1>
      <p class="sub"><%= t('register.subtitle') %></p>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form method="POST" action="<%= locale === 'ar' ? '/ar/register' : '/register' %>" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label for="name"><%= t('register.labelName') %><span class="req">*</span></label>
          <input type="text" id="name" name="name" autocomplete="name" placeholder="<%= t('register.placeholderName') %>" maxlength="60" data-validate="name" required autofocus>
          <div class="field-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= t('register.errName') %></span></div>
        </div>
        <div class="field">
          <label for="civilId"><%= t('register.labelCivilId') %><span class="req">*</span></label>
          <input type="text" id="civilId" name="civilId" placeholder="<%= t('register.placeholderCivilId') %>" inputmode="numeric" autocomplete="username" maxlength="12" pattern="\d{12}" data-validate="civilid" required aria-describedby="civilIdHint">
          <div class="hint hint-secure" id="civilIdHint"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg><span><%= t('register.hintCivilId') %></span></div>
          <div class="field-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= t('register.errCivilId') %></span></div>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="email"><%= t('register.labelEmail') %><span class="req">*</span></label>
            <input type="email" id="email" name="email" autocomplete="email" placeholder="<%= t('register.placeholderEmail') %>" data-validate="email" required>
            <div class="field-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= t('register.errEmail') %></span></div>
          </div>
          <div class="field">
            <label for="phone"><%= t('register.labelPhone') %><span class="req">*</span></label>
            <input type="tel" id="phone" name="phone" inputmode="tel" autocomplete="tel" placeholder="<%= t('register.placeholderPhone') %>" data-validate="phone" required>
            <div class="field-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= t('register.errPhone') %></span></div>
          </div>
        </div>
        <div class="field">
          <label for="password"><%= t('register.labelPassword') %><span class="req">*</span></label>
          <div class="password-field">
            <input type="password" id="password" name="password" autocomplete="new-password" placeholder="<%= t('register.placeholderPassword') %>" data-validate="password" required>
            <button type="button" class="password-toggle" data-toggle-for="password" aria-label="<%= t('register.showPassword') %>" data-show-label="<%= t('register.showPassword') %>" data-hide-label="<%= t('register.hidePassword') %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg></button>
          </div>
          <div class="field-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= t('register.errPassword') %></span></div>
        </div>
        <div class="field">
          <label for="confirmPassword"><%= t('register.labelConfirmPassword') %><span class="req">*</span></label>
          <div class="password-field">
            <input type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password" placeholder="<%= t('register.placeholderConfirmPassword') %>" data-validate="confirm-password" data-match="password" required>
            <button type="button" class="password-toggle" data-toggle-for="confirmPassword" aria-label="<%= t('register.showPassword') %>" data-show-label="<%= t('register.showPassword') %>" data-hide-label="<%= t('register.hidePassword') %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg></button>
          </div>
          <div class="field-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= t('register.errConfirmPassword') %></span></div>
        </div>
        <div class="field" style="display:flex; align-items:flex-start; gap:10px;">
          <input type="checkbox" id="agreeTerms" name="agreeTerms" required style="margin-top:2px;">
          <label for="agreeTerms" style="font-weight:400;"><%= t('register.agreeTermsPre') %> <a href="/terms" style="color:var(--lime-700); font-weight:600;"><%= t('register.agreeTermsLink') %></a><span class="req">*</span></label>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;"><%= t('register.submit') %></button>
      </form>
      <div class="auth-foot"><%= t('register.haveAccount') %> <a href="<%= locale === 'ar' ? '/ar/login' : '/login' %>" style="color:var(--lime-700); font-weight:600;"><%= t('register.logIn') %></a></div>
    </div>
  </main>
</body>
</html>
