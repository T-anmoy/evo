<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
<head>
<%- include('partials/head', { title: t('meta.login.title'), description: t('meta.login.description') }) %>
</head>
<body>
  <main id="main-content" class="auth-shell">
    <div class="auth-card">
      <%- include('partials/auth-nav') %>
      <div class="logo"><span>Evo <span class="dot">Meals</span></span></div>
      <h1><%= t('login.title') %></h1>
      <p class="sub"><%= t('login.subtitle') %></p>

      <% if (error) { %>
        <div class="alert alert-error" role="alert"><%= error %></div>
      <% } %>

      <form method="POST" action="<%= locale === 'ar' ? '/ar/login' : '/login' %>" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field <%= (typeof errors !== 'undefined' && errors.civilId) ? 'invalid' : '' %>">
          <label for="civilId"><%= t('login.labelCivilId') %></label>
          <input type="text" id="civilId" name="civilId" inputmode="numeric" autocomplete="username" maxlength="12" pattern="\d{12}" data-validate="civilid" placeholder="<%= t('login.placeholderCivilId') %>" required aria-describedby="loginCivilIdHint civilId-error" aria-invalid="<%= (typeof errors !== 'undefined' && errors && errors.civilId) ? 'true' : 'false' %>">
          <div class="hint hint-secure" id="loginCivilIdHint"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg><span><%= t('login.hintCivilId') %></span></div>
          <div class="field-error" id="civilId-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= (typeof errors !== 'undefined' && errors.civilId) || t('login.errCivilId') %></span></div>
        </div>
        <div class="field">
          <label for="password"><%= t('login.labelPassword') %></label>
          <input type="password" id="password" name="password" autocomplete="current-password" placeholder="<%= t('login.placeholderPassword') %>" required data-validate="required" aria-describedby="password-error" aria-invalid="<%= (typeof errors !== 'undefined' && errors && errors.password) ? 'true' : 'false' %>">
          <div class="field-error" id="password-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= t('common.valRequired') %></span></div>
          <div style="text-align:end; margin-top:6px;"><a href="<%= locale === 'ar' ? '/ar/forgot-password' : '/forgot-password' %>" style="color:var(--leaf-dark); font-weight:600; font-size:15px;"><%= t('login.forgotPassword') %></a></div>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;"><%= t('login.submit') %></button>
      </form>

      <!-- Demo credentials (Civil ID 111111111111 / demo1234) intentionally not
           shown here — this is a public-facing page. The login itself still
           accepts them; see README/project notes for the test account. -->
      <div class="auth-foot"><%= t('login.noAccount') %> <a href="<%= locale === 'ar' ? '/ar/register' : '/register' %>" style="color:var(--leaf-dark); font-weight:600;"><%= t('login.signUp') %></a></div>
    </div>
  </main>
</body>
</html>
