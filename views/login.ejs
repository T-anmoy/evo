<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Log in — Evo Meals' }) %>
</head>
<body>
  <div class="auth-shell">
    <div class="auth-card">
      <div class="logo"><span>Evo <span class="dot">Meals</span></span></div>
      <h1>Welcome back</h1>
      <p class="sub">Log in to book meals and manage your children's accounts.</p>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form method="POST" action="/login">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field">
          <label for="civilId">Civil ID</label>
          <input type="text" id="civilId" name="civilId" placeholder="e.g. 111111111111" required autofocus>
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="Enter your password" required>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;">Log In</button>
      </form>

      <!-- Demo credentials (Civil ID 111111111111 / demo1234) intentionally not
           shown here — this is a public-facing page. The login itself still
           accepts them; see README/project notes for the test account. -->
      <div class="auth-foot">Don't have an account? <a href="/register" style="color:var(--lime-700); font-weight:600;">Sign up</a></div>
    </div>
  </div>
</body>
</html>
