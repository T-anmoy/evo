<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
<head>
<%- include('partials/head', { title: t('meta.booking.title') }) %>
</head>
<body>
<%- include('partials/appnav', { active: 'booking' }) %>

<main class="page" id="main-content" style="max-width:680px;">
  <div class="page-head">
    <span class="eyebrow"><%= t('booking.eyebrow') %></span>
    <h1><%= t('booking.heading') %></h1>
    <p><%= t('booking.intro') %></p>
  </div>

  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <% if (success) { %><div class="alert alert-success"><%- include('partials/success-icon') %><span><%= success %></span></div><% } %>
  <% if (typeof rebook !== 'undefined' && rebook) { %>
    <div class="alert alert-info"><%= t('booking.rebookInfo') %></div>
  <% } %>

  <div class="card">
    <% if (students.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 9a7 7 0 0 1 14 0"/></svg></div>
        <p><strong><%= t('booking.emptyTitle') %></strong><%= t('booking.emptyBody') %></p>
        <a href="/students" class="btn btn-primary btn-sm" style="margin-top:16px;"><%= t('booking.emptyCta') %></a>
      </div>
    <% } else { %>
      <% // Rebooking wins if present; otherwise fall back to this parent's
         // own smart defaults (most recently used student, most-booked
         // meal) computed on the server, so a fresh booking never starts
         // from an arbitrary "first in the list" pick. %>
      <% const rebookStudentId = (typeof rebook !== 'undefined' && rebook) ? rebook.studentId : (typeof defaultStudentId !== 'undefined' ? defaultStudentId : null); %>
      <% const rebookMenuId = (typeof rebook !== 'undefined' && rebook) ? rebook.menuItemId : ((typeof defaultMenuId !== 'undefined' && defaultMenuId) ? defaultMenuId : (menuItems[0] && menuItems[0].id)); %>
      <% const rebookPlan = (typeof rebook !== 'undefined' && rebook) ? rebook.planType : 'monthly'; %>
      <form method="POST" action="/booking" id="bookingForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="field">
          <label for="studentSelect"><%= t('booking.labelStudent') %></label>
          <select name="studentId" id="studentSelect" required>
            <% students.forEach(s => { %>
              <option value="<%= s.id %>" data-school="<%= s.school %>" data-class="<%= s.class %>" <%= s.id === rebookStudentId ? 'selected' : '' %>><%= s.name %> — <%= s.school %></option>
            <% }) %>
          </select>
          <span class="hint" id="agePortionHint"></span>
        </div>

        <div class="field">
          <label><%= t('booking.labelMeal') %> <span style="font-weight:400; color:var(--muted);"><%= t('booking.labelMealHint') %></span></label>
          <div class="picker-grid">
            <% menuItems.forEach((m, i) => { %>
              <div class="picker-card">
                <input type="radio" name="menuItemId" id="meal-<%= m.id %>" value="<%= m.id %>" <%= m.id === rebookMenuId ? 'checked' : '' %> required>
                <label for="meal-<%= m.id %>">
                  <span class="picker-thumb"><%- include('partials/dish-image', { m: m }) %></span>
                  <span class="picker-body">
                    <strong><%= m.name %></strong>
                    <span class="picker-meta"><bdi><%= m.calories %> <%= t('common.kcal') %> · <%= m.protein %>g <%= t('common.protein') %></bdi></span>
                  </span>
                  <span class="check-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
                </label>
              </div>
            <% }) %>
          </div>
        </div>

        <div class="field">
          <label><%= t('booking.labelPlan') %></label>
          <div class="picker-grid plan-picker">
            <div class="picker-card">
              <input type="radio" name="planType" id="plan-single" value="single" <%= rebookPlan === 'single' ? 'checked' : '' %>>
              <label for="plan-single">
                <span class="plan-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg></span>
                <span class="picker-body">
                  <strong><%= t('booking.planSingleTitle') %></strong>
                  <span class="picker-meta data-num"><bdi>KWD <%= dailyRateKWD.toFixed(3) %></bdi> <%= t('booking.planSinglePer') %></span>
                </span>
                <span class="check-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
              </label>
            </div>
            <div class="picker-card">
              <input type="radio" name="planType" id="plan-monthly" value="monthly" <%= rebookPlan === 'monthly' ? 'checked' : '' %>>
              <label for="plan-monthly">
                <span class="popular-tag"><%= t('booking.planMonthlyBadge') %></span>
                <span class="plan-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.83 2.83 0 0 1 4 4L7 21l-5 1 1-5Z"/></svg></span>
                <span class="picker-body">
                  <strong><%= t('booking.planMonthlyTitle') %></strong>
                  <span class="picker-meta"><%= t('booking.planMonthlyMeta') %></span>
                </span>
                <span class="check-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></span>
              </label>
            </div>
          </div>
        </div>

        <div class="form-row">
          <div class="field">
            <label for="startDate"><%= t('booking.labelStartDate') %></label>
            <input type="date" name="startDate" id="startDate" value="<%= new Date().toISOString().split('T')[0] %>" required>
          </div>
          <div class="field" id="daysField">
            <label for="daysInput"><%= t('booking.labelDays') %></label>
            <input type="number" name="days" id="daysInput" inputmode="numeric" value="5" min="1" max="30">
          </div>
        </div>

        <p id="calendarNote" class="hint" style="margin:-6px 0 18px;"></p>

        <div class="confirm-bar" id="confirmBar">
          <div id="totalBox" style="display:flex; justify-content:space-between; align-items:center;">
            <span style="color:rgba(255,255,255,0.65); font-size:13px; font-weight:500;"><%= t('booking.totalDue') %></span>
            <strong id="totalAmt" class="data-num" style="color:var(--lime-300); font-size:20px;"><bdi>KWD 0.000</bdi></strong>
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%;" id="confirmBtn"><%= t('booking.confirmCta') %></button>
        </div>
        <p class="hint" style="text-align:center; margin-top:8px;"><%= t('booking.knetHint') %></p>
      </form>
    <% } %>
  </div>
</main>

<script>
  var SCHOOL_CALENDAR = <%- JSON.stringify(schoolCalendar) %>;
  var DAILY_RATE = <%- JSON.stringify(dailyRateKWD) %>;
  // Translated fragments for the client-side live-preview calculation
  // below — the same strings the server would use if this were a full
  // page reload, so the preview never drifts into English while the rest
  // of the page is Arabic (or vice versa).
  var T = {
    agePortionHint: <%- JSON.stringify(t('booking.agePortionHint')) %>,
    noSchoolDaysNote: <%- JSON.stringify(t('booking.noSchoolDaysNote')) %>,
    realSchoolDaysNote: <%- JSON.stringify(t('booking.realSchoolDaysNote')) %>,
    realSchoolDayUnitOne: <%- JSON.stringify(t('booking.realSchoolDayUnitOne')) %>,
    realSchoolDayUnitOther: <%- JSON.stringify(t('booking.realSchoolDayUnitOther')) %>
  };
  function fmt(str, vars) {
    return str.replace(/\{(\w+)\}/g, function (m, k) { return (k in vars) ? vars[k] : m; });
  }

  function endOfMonthISO(dateISO) {
    var d = new Date(dateISO + 'T00:00:00Z');
    var end = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth() + 1, 0));
    return end.toISOString().split('T')[0];
  }

  function schoolDaysInRange(school, startISO, endISO) {
    var days = SCHOOL_CALENDAR[school] || [];
    return days.filter(function (d) { return d >= startISO && d <= endISO; });
  }

  function recalc(){
    var planEl = document.querySelector('input[name="planType"]:checked');
    var plan = planEl ? planEl.value : 'single';
    var daysField = document.getElementById('daysField');
    var daysInput = document.getElementById('daysInput');
    var note = document.getElementById('calendarNote');
    var confirmBtn = document.getElementById('confirmBtn');
    var studentSelect = document.getElementById('studentSelect');
    var startDateInput = document.getElementById('startDate');
    var ageHint = document.getElementById('agePortionHint');
    if (!studentSelect || !daysField || !note || !confirmBtn || !startDateInput) return;
    var selected = studentSelect.options[studentSelect.selectedIndex];
    if (ageHint && selected) {
      var klass = selected.getAttribute('data-class');
      ageHint.textContent = klass ? fmt(T.agePortionHint, { className: klass }) : '';
    }

    if (plan === 'monthly') {
      daysField.style.display = 'none';
      var selectedOption = studentSelect.options[studentSelect.selectedIndex];
      var school = selectedOption ? selectedOption.getAttribute('data-school') : null;
      var startISO = startDateInput.value;
      if (school && startISO) {
        var monthEndISO = endOfMonthISO(startISO);
        var realDays = schoolDaysInRange(school, startISO, monthEndISO);
        var total = Math.round(realDays.length * DAILY_RATE * 1000) / 1000;
        document.getElementById('totalAmt').textContent = 'KWD ' + total.toFixed(3);
        if (realDays.length === 0) {
          note.textContent = fmt(T.noSchoolDaysNote, { school: school, startDate: startISO });
          confirmBtn.disabled = true;
        } else {
          note.textContent = fmt(T.realSchoolDaysNote, {
            count: realDays.length,
            unit: realDays.length === 1 ? T.realSchoolDayUnitOne : T.realSchoolDayUnitOther,
            school: school, startDate: startISO, monthEnd: monthEndISO
          });
          confirmBtn.disabled = false;
        }
      } else {
        note.textContent = '';
        confirmBtn.disabled = false;
      }
    } else {
      daysField.style.display = 'block';
      note.textContent = '';
      confirmBtn.disabled = false;
      var d = Math.max(1, parseInt(daysInput.value, 10) || 1);
      document.getElementById('totalAmt').textContent = 'KWD ' + (d * DAILY_RATE).toFixed(3);
    }
  }
  document.querySelectorAll('input[name="planType"]').forEach(function(el){ el.addEventListener('change', recalc); });
  var daysInputEl = document.getElementById('daysInput');
  if (daysInputEl) daysInputEl.addEventListener('input', recalc);
  var studentSelectEl = document.getElementById('studentSelect');
  if (studentSelectEl) studentSelectEl.addEventListener('change', recalc);
  var startDateEl = document.getElementById('startDate');
  if (startDateEl) startDateEl.addEventListener('change', recalc);
  document.addEventListener('DOMContentLoaded', recalc);
</script>

<%- include('partials/appfoot') %>
</body>
</html>
