<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head><%- include('partials/head', { title: t('meta.booking.title') }) %></head>
<body>
<%- include('partials/appnav', { active: 'booking' }) %>
<main class="page subscription-page" id="main-content">
  <div class="page-head"><span class="eyebrow"><%= t('booking.eyebrow') %></span><h1><%= t('subscription.titles.' + step) %></h1></div>
  <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
  <% if (step === 'list') { %>
    <p class="hint booking-calendar-note"><%= t('subscription.calendarNote') %></p>
    <% if (!students.length) { %><div class="card empty-state"><p><%= t('booking.emptyBody') %></p><a href="/students#add-student" class="btn btn-primary"><%= t('students.addButton') %></a></div><% } %>
    <div class="booking-students">
      <% students.forEach(student => { %><article class="card booking-student-card">
        <div class="booking-student-heading"><span class="avatar" aria-hidden="true"><%= student.name.charAt(0) %></span><h2><bdi><%= student.name %></bdi></h2></div><p class="booking-meal-type"><bdi><%= student.mealType === "Regular Meal" ? t("subscription.regularMeal") : student.mealType %></bdi></p><p class="booking-student-school"><bdi><%= student.school %></bdi> · <%= t("students.classes." + student.class) %></p>
        <a class="btn btn-primary" href="/booking/new?student=<%= student.id %>"><%= t('subscription.bookNow') %></a>
      </article><% }) %>
    </div>
  <% } else if (step === 'new') { %>
    <p class="alert alert-info"><%= t('subscription.leadBanner') %></p>
    <div class="card"><form method="POST" action="/booking/review">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="student" value="<%= student.id %>">
      <div class="field"><label for="booking-date"><%= t('subscription.bookingDate') %></label><input id="booking-date" value="<%= today %>" readonly></div>
      <div class="field"><label for="booking-student"><%= t('booking.labelStudent') %></label><input id="booking-student" value="<%= student.name %>" readonly></div>
      <div class="field"><label for="booking-class"><%= t('students.labelClass') %></label><input id="booking-class" value="<%= student.class %>" readonly></div>
      <div class="field"><label for="months-count"><%= t('subscription.numberMonths') %></label>
        <select name="months" id="months-count" required><% for(let n=1;n<=maxMonths;n++){ %><option value="<%= n %>" <%= count===n ? 'selected' : '' %>><%= n %></option><% } %></select>
      </div>
      <p><%= t('subscription.monthPreview') %></p><ul class="month-preview"><% preview.forEach((month,i)=>{ %><li data-month-index="<%= i %>" <%= i>=count ? 'hidden' : '' %>><%= fmtMonth(month,locale) %></li><% }) %></ul>
      <div class="action-row"><button class="btn btn-outline" type="submit" formmethod="GET" formaction="/booking/new"><%= t('subscription.preview') %></button><button class="btn btn-primary" type="submit"><%= t('subscription.next') %></button></div>
    </form></div>
    <script src="/js/subscription.js" defer></script>
  <% } else if (step === 'review') { %>
    <p><%= student.name %> · <%= student.school %></p>
    <%- include('partials/subscription-review', { months: draft.months, totalKWD: draft.totalKWD }) %>
    <% if (!draft.error || draft.error === 'priceChanged' || draft.error === 'expired') { %><a href="/booking/meals" class="btn btn-primary"><%= t('subscription.next') %></a><% } %>
    <a class="btn btn-outline" href="/booking/new?student=<%= student.id %>"><%= t('subscription.startAgain') %></a>
  <% } else if (step === 'terms') { %>
    <div class="card">
      <% if (locale === 'ar') { %><p><%= t('termsDialog.englishNote') %></p><% } %>
      <div class="legal-content" lang="en" dir="ltr"><%- include('partials/terms-content') %></div>
      <form method="POST" action="/booking/accept-terms"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="token" value="<%= draft.token %>">
        <button class="btn btn-primary"><%= t('termsDialog.accept') %></button><a href="/booking/meals" class="btn btn-outline"><%= t('termsDialog.decline') %></a>
      </form>
    </div>
  <% } else if (step === 'payment') { %>
    <div class="card"><h2><%= student.name %></h2><p><%= student.school %></p>
      <%- include('partials/subscription-review', { months: draft.months, totalKWD: draft.totalKWD }) %>
      <fieldset class="field"><legend><%= t('subscription.paymentMethod') %></legend><label><input type="radio" name="method" value="KNET" checked> <%= t('subscription.knet') %></label></fieldset>
      <p><%= t('subscription.payable') %>: <bdi><%= fmtKWD(draft.totalKWD) %></bdi></p><p class="hint"><%= t('subscription.simulated') %></p>
      <a href="/booking/knet" class="btn btn-primary"><%= t('subscription.continuePayment') %></a>
    </div>
  <% } else if (step === 'knet') { %>
    <div class="card"><h2><%= t('meta.siteName') %></h2><p class="alert alert-info"><%= t('subscription.simulated') %></p>
      <p><%= t('subscription.payable') %>: <bdi><%= fmtKWD(draft.totalKWD) %></bdi></p>
      <form method="POST" action="/booking/pay"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="token" value="<%= draft.token %>"><button class="btn btn-primary"><%= t('subscription.pay') %></button></form>
    </div>
  <% } else if (step === 'confirmation') { %>
    <div class="card"><div class="alert alert-success" role="status"><%- include('partials/success-icon') %><span><%= t('subscription.confirmed') %></span></div>
      <h2><%= subscription.student_name %></h2><p><%= subscription.school %></p><p><bdi><%= subscription.invoice_number %> · <%= fmtKWD(subscription.total_kwd) %></bdi></p>
      <p class="hint"><%= t('subscription.simulated') %></p>
      <div class="action-row"><a class="btn btn-primary" href="/history/<%= subscription.id %>/invoice.pdf"><%= t('subscription.invoice') %></a><a class="btn btn-outline" href="/subscriptions/<%= subscription.id %>/meals"><%= t('subscription.changeMeals') %></a><a class="btn btn-outline" href="/dashboard"><%= t('notFound.backToDashboard') %></a></div>
    </div>
  <% } %>
</main>
<%- include('partials/appfoot') %>
</body></html>
