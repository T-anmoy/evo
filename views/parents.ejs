<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
<head>
<%- include('partials/head', { title: t('meta.parents.title'), description: t('meta.parents.description') }) %>
</head>
<body>

<%- include('partials/sitenav', { active: 'parents' }) %>

<main id="main-content" tabindex="-1">
<section class="section parent-intro">
  <div class="wrap">
    <div class="parent-intro-copy">
      <span class="eyebrow"><%= t('parents.hero.eyebrow') %></span>
      <h1><%= t('parents.hero.headline1') %></h1>
      <p class="lede"><%= t('parents.hero.lede') %></p>
      <div class="action-row"><a href="<%= locale === 'ar' ? '/ar/register' : '/register' %>" class="btn btn-primary"><%= t('common.createAccount') %></a><a href="<%= locale === 'ar' ? '/ar' : '/' %>#supported-schools"><%= t('nav.checkMySchool') %> →</a></div>
    </div>
    <% if(menuItems[0]) { %><%- include('partials/food-card', {m:menuItems[0],variant:'featured',eager:true,reveal:true}) %><% } %>
    <%- include('partials/food-confidence', {reveal:true}) %>
  </div>
</section>
<!-- 3. Menu + nutrition + allergen information -->
<section class="section" id="menu">
  <div class="wrap">
    <div class="section-head" data-reveal-group>
      <span data-reveal="up" class="eyebrow"><%= t('parents.menu.eyebrow') %></span>
      <h2 data-reveal="up"><%= t('parents.menu.heading') %></h2>
      <p data-reveal="up"><%= t('parents.menu.intro') %></p>
    </div>
    <div class="food-grid food-supporting" data-reveal-group>
      <% menuItems.slice(1).forEach(m => { %><%- include('partials/food-card', {m,variant:'compact',reveal:true}) %><% }) %>
    </div>
    <p class="nutrition-more"><%= t('parents.menu.footnote') %></p>
  </div>
</section>

<section class="section on-tint" id="journey"><div class="wrap">
  <div class="section-head" data-reveal-group><span data-reveal="up" class="eyebrow"><%= t('parents.journey.eyebrow') %></span><h2 data-reveal="up"><%= t('parents.journey.heading') %></h2><p data-reveal="up"><%= t('parents.journey.intro') %></p></div>
  <%- include('partials/parent-journey') %>
</div></section>
<!-- 4. Calendar-aware pricing explanation -->
<section class="section" id="pricing">
  <div class="wrap">
    <div class="section-head" data-reveal-group>
      <span data-reveal="up" class="eyebrow"><%= t('parents.pricing.eyebrow') %></span>
      <h2 data-reveal="up"><%= t('parents.pricing.heading') %></h2>
      <p data-reveal="up"><%= t('parents.pricing.intro') %></p>
    </div>
    <div class="pricing-grid" data-reveal-group>
      <div class="price-card" data-reveal="up">
        <div class="price-tag"><%= t('parents.pricing.payAsYouGoTitle') %></div>
        <div class="price-amt"><bdi>KWD <%= (plans.single ? plans.single.rateKWD : 2).toFixed(3) %></bdi><span><%= t('parents.pricing.payAsYouGoPer') %></span></div>
        <p><%= t('parents.pricing.payAsYouGoBody') %></p>
        <a href="<%= locale === 'ar' ? '/ar/register' : '/register' %>" class="btn btn-outline" style="width:100%;"><%= t('parents.pricing.payAsYouGoCta') %></a>
      </div>
      <div class="price-card" data-reveal="up">
        <div class="price-tag"><%= t('parents.pricing.subscriptionTitle') %></div>
        <div class="price-amt"><bdi>KWD <%= (plans.single ? plans.single.rateKWD : 2).toFixed(3) %></bdi><span><%= t('parents.pricing.subscriptionPer') %></span></div>
        <p><%= t('parents.pricing.subscriptionBody') %></p>
        <a href="<%= locale === 'ar' ? '/ar/register' : '/register' %>" class="btn btn-outline" style="width:100%;"><%= t('parents.pricing.subscriptionCta') %></a>
      </div>
    </div>
  </div>
</section>

<!-- 5. Tap-to-collect + notification -->
<section class="section" id="collection">
  <div class="wrap">
    <div class="section-head" data-reveal-group>
      <span data-reveal="up" class="eyebrow"><%= t('parents.collection.eyebrow') %></span>
      <h2 data-reveal="up"><%= t('parents.collection.heading') %></h2>
      <p data-reveal="up"><%= t('parents.collection.intro') %></p>
    </div>
    <%- include('partials/collection-demo') %>
  </div>
</section>

<!-- 6. Multiple children -->
<section class="section on-tint" id="multiple-children">
  <div class="wrap what-is-wrap" data-reveal-group>
    <div data-reveal="up">
      <span class="eyebrow"><%= t('parents.multipleChildren.eyebrow') %></span>
      <h2><%= t('parents.multipleChildren.heading') %></h2>
      <p><%= t('parents.multipleChildren.intro') %></p>
    </div>
    <div class="card" data-reveal="up" style="max-width:480px;">
      <div class="dash-preview-head" style="padding:0 0 14px;">
        <strong style="font-family:var(--font-heading); font-size:15px; color:var(--forest);"><%= t('parents.multipleChildren.cardTitle') %></strong>
        <span class="sample-tag"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg> <%= t('parents.multipleChildren.sampleView') %></span>
      </div>
      <div class="student-row">
        <div class="avatar">A</div>
        <div class="student-meta">
          <strong>Ahmed</strong>
          <span><%= t('parents.multipleChildren.child1School') %></span>
        </div>
        <span class="status-line ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M20 6 9 17l-5-5"/></svg> <%= t('parents.multipleChildren.statusCollected') %></span>
      </div>
      <div class="student-row">
        <div class="avatar">S</div>
        <div class="student-meta">
          <strong>Sara</strong>
          <span><%= t('parents.multipleChildren.child2School') %></span>
        </div>
        <span class="status-line pending"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg> <%= t('parents.multipleChildren.statusBooked') %></span>
      </div>
    </div>
  </div>
</section>

<!-- 7. App -->
<section class="section" id="app">
  <div class="wrap app-section-wrap">
    <div data-reveal="up">
      <span class="eyebrow"><%= t('parents.app.eyebrow') %></span>
      <h2><%= t('parents.app.headingLine1') %><br><%= t('parents.app.headingLine2') %></h2>
      <p class="app-capabilities"><%= t('home.app.flowMenu') %> <span aria-hidden="true">·</span> <%= t('home.app.flowSubscription') %> <span aria-hidden="true">·</span> <%= t('home.app.flowOrder') %></p>
      <p class="app-download-cta" style="font-weight:700; margin-bottom:10px;"><%= t('parents.app.downloadCta') %></p>
      <div class="store-badges">
        <a href="https://apps.apple.com/us/app/evo-school-meal/id6738001343" class="store-badge" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zm3.63-3.331c.837-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.817-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701z"/></svg>
          <span><%= t('common.appStore') %></span>
        </a>
        <a href="https://play.google.com/store/apps/details?id=com.pmg.school" class="store-badge" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zM13.792 12l3.606-3.583L4.24.936A1.5 1.5 0 0 0 3.312.7L13.792 12zM3.24 23.316a1.5 1.5 0 0 0 .928-.235l12.876-7.462-3.604-3.552L3.24 23.316z"/></svg>
          <span><%= t('common.googlePlay') %></span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- 8. FAQ (short pointer — full FAQ lives on the homepage) -->
<section class="section on-tint" id="faq">
  <div class="wrap" style="text-align:center; max-width:640px;">
    <span class="eyebrow" style="justify-content:center;"><%= t('parents.faq.eyebrow') %></span>
    <h2 style="margin:16px 0 14px;"><%= t('parents.faq.heading') %></h2>
    <p style="color:var(--forest-secondary); font-size:15.5px; margin-bottom:28px;"><%- t('parents.faq.body', {
      fullFaq: `<a href="${locale === 'ar' ? '/ar' : '/'}#faq">${t('parents.faq.fullFaqLink')}</a>`,
      features: `<a href="${locale === 'ar' ? '/ar/features' : '/features'}">${t('parents.faq.featuresLink')}</a>`
    }) %></p>
  </div>
</section>

<!-- 9. Registration/login CTA -->
<section class="cta-band">
  <div class="wrap" style="text-align:center;" data-reveal-group>
    <span data-reveal="up" class="eyebrow on-dark" style="justify-content:center;"><%= t('parents.finalCta.eyebrow') %></span>
    <h2 data-reveal="up" style="margin-top:16px;"><%= t('parents.finalCta.heading') %></h2>
    <p data-reveal="up" style="margin:14px auto 28px;"><%= t('parents.finalCta.body') %></p>
    <div data-reveal="up" class="hero-actions" style="justify-content:center;">
      <a href="<%= locale === 'ar' ? '/ar/register' : '/register' %>" class="btn btn-school-yellow"><%= t('common.createAccount') %></a>
      <a href="<%= locale === 'ar' ? '/ar/login' : '/login' %>" class="btn btn-outline-light"><%= t('common.login') %></a>
    </div>
  </div>
</section>
</main>

<%- include('partials/sitefoot') %>

</body>
</html>
