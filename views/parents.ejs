<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'For Parents — Evo Meals' }) %>
<meta name="description" content="Book school meals, manage subscriptions, and know the moment your child collects lunch — all from the Evo Meals parent account. Real-time notifications, allergen-checked menus, and calendar-accurate KNET payments.">
</head>
<body>

<%- include('partials/sitenav', { active: 'parents' }) %>

<!-- 1. Hero -->
<section class="hero hero-inner-page">
  <div class="wrap-wide hero-inner">
    <div class="hero-copy" data-reveal>
      <span class="eyebrow on-dark">For Parents</span>
      <h1>Know they ate.<br>Know what they ate.<br><em>Never have to ask.</em></h1>
      <p class="lede">One account for every child, every meal. Book a plan, pay only for the real school days it covers, and see the exact moment they've collected lunch — dish, time, done.</p>
      <div class="hero-actions">
        <a href="/register" class="btn btn-primary">Create your account</a>
        <a href="/login" class="btn btn-ghost">Log in</a>
      </div>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <div class="tap-demo">
        <div class="tap-card">
          <div class="chip"></div>
          <div class="card-name">Ahmed A.</div>
        </div>
        <div class="tap-reader pulse">
          <div class="ripple"></div>
          <div class="ripple delay"></div>
          <div class="reader-ring">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 8.5a8 8 0 0 1 12 0M8.5 11a4.5 4.5 0 0 1 7 0M12 14v.01"/></svg>
          </div>
          <div class="reader-label">MEAL READER · GATE 2</div>
        </div>
        <div class="tap-toast">
          <div class="toast-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" pathLength="1"><path d="M20 6 9 17l-5-5"/></svg>
          </div>
          <div>
            <div class="toast-title">Ahmed tapped in — lunch collected</div>
            <div class="toast-sub">12:14 PM · Arabiatta Chicken Pasta · illustrative example</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 2. How the parent journey works -->
<section class="section on-tint">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="eyebrow">How it works for you</span>
      <h2>Four steps, once a term.</h2>
      <p>Set it up once. From then on, lunch just happens — and you find out about it, instead of wondering.</p>
    </div>

    <ul class="value-checklist" data-reveal>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg> Convenience</li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg> Transparent menus</li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg> Easy subscriptions</li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg> Digital payments</li>
      <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg> Notifications</li>
    </ul>

    <div class="steps">
      <div class="step" data-reveal data-reveal-group="psteps">
        <div class="step-num">Book</div>
        <h3>Pick a plan</h3>
        <p>Real school days, real total — shown before you confirm.</p>
      </div>
      <div class="step" data-reveal data-reveal-group="psteps">
        <div class="step-num">Pay</div>
        <h3>Pay via KNET</h3>
        <p>Pay the exact amount. No wallet, no top-ups, no forgotten lunch money.</p>
      </div>
      <div class="step" data-reveal data-reveal-group="psteps">
        <div class="step-num">Tap</div>
        <h3>Your child taps in</h3>
        <p>One tap at the counter. No PIN, no cash queue.</p>
      </div>
      <div class="step" data-reveal data-reveal-group="psteps">
        <div class="step-num">Notified</div>
        <h3>You see it happen</h3>
        <p>The moment they tap, you know — which meal, what time.</p>
      </div>
    </div>

    <div class="journey-block" data-reveal>
      <span class="journey-label">Your complete parent journey — not just booking</span>
      <ul class="journey-pills">
        <li>View the menu</li>
        <li>Check nutritional info</li>
        <li>Subscribe to a plan</li>
        <li>Select meals</li>
        <li>Pay securely</li>
        <li>Track orders</li>
        <li>Get notifications</li>
        <li class="journey-pill-emphasis">Manage multiple children</li>
        <li class="journey-pill-emphasis">Renew your subscription</li>
      </ul>
    </div>
  </div>
</section>

<!-- 3. Menu + nutrition + allergen information -->
<section class="section" id="menu">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="eyebrow">This week's menu</span>
      <h2>Real meals, real nutrition, on the record.</h2>
      <p>Every dish is checked against your child's allergy profile before it's ever offered as an option.</p>
    </div>
    <div class="allergen-row" style="justify-content:center;">
      <span class="allergen-pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4M12 17h.01"/><circle cx="12" cy="12" r="9"/></svg> Allergen information available per dish</span>
    </div>
    <div class="grid-4">
      <% menuItems.forEach(m => { %>
        <div class="menu-card" data-reveal data-reveal-group="pmenu">
          <div class="menu-thumb">
            <%- include('partials/dish-image', { m: m }) %>
          </div>
          <div class="menu-card-body">
            <span class="tag"><%= m.tag %></span>
            <h3><%= m.name %></h3>
            <div class="menu-nutri"><span><%= m.calories %> kcal</span><span>·</span><span><%= m.protein %>g protein</span></div>
          </div>
        </div>
      <% }) %>
    </div>
    <p class="nutrition-more" data-reveal>Allergen and dietary claims are per-dish information, not an independently verified guarantee — check each dish's own detail if your child has a specific allergy. Full ingredients and carb/fat breakdowns are on every dish once you're logged in.</p>
  </div>
</section>

<!-- 4. Calendar-aware pricing explanation -->
<section class="section on-tint" id="pricing">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="eyebrow">Pricing</span>
      <h2>One price, shown before you pay.</h2>
      <p>You pay for the school days covered by the booking period — never a flat monthly guess, and never a hidden number.</p>
    </div>
    <div class="pricing-grid">
      <div class="price-card" data-reveal data-reveal-group="ppricing">
        <div class="price-tag">Pay as you go</div>
        <div class="price-amt">KWD <%= (plans.single ? plans.single.rateKWD : 2).toFixed(3) %><span>/day</span></div>
        <p>Book single days whenever you need to — school trips, half terms, or just trying it out.</p>
        <a href="/register" class="btn btn-outline" style="width:100%;">Start booking</a>
      </div>
      <div class="price-card featured" data-reveal data-reveal-group="ppricing">
        <div class="price-tag">Subscription</div>
        <div class="price-amt">KWD <%= (plans.single ? plans.single.rateKWD : 2).toFixed(3) %><span>/real school day</span></div>
        <p>You pay only for the real school days in your booking period — calculated against your school's actual calendar, checked against the same rate shown here.</p>
        <a href="/register" class="btn btn-primary" style="width:100%;">Start a subscription</a>
      </div>
    </div>
  </div>
</section>

<!-- 5. Tap-to-collect + notification -->
<section class="section" id="collection">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="eyebrow">The moment that matters</span>
      <h2>Know when the meal was collected.</h2>
      <p>Once your child taps their meal card at the counter, the booking is marked collected and you're notified — no need to ask them how lunch went.</p>
    </div>
    <div class="flow-caption">
      <span>Tap</span><span class="flow-caption-arrow">→</span><span>Collected</span><span class="flow-caption-arrow">→</span><span>Notified</span>
    </div>
    <div class="card" data-reveal style="max-width:480px; margin:0 auto;">
      <div class="dash-preview-head" style="padding:0 0 14px;">
        <strong style="font-family:'Montserrat',Arial,sans-serif; font-size:15px; color:var(--navy-950);">Your dashboard</strong>
        <span class="sample-tag"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg> Sample view</span>
      </div>
      <div class="student-row">
        <div class="avatar">A</div>
        <div class="student-meta">
          <strong>Ahmed</strong>
          <span>Arabiatta Chicken Pasta</span>
        </div>
        <span class="status-line ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M20 6 9 17l-5-5"/></svg> Collected at 12:14 PM</span>
      </div>
    </div>
  </div>
</section>

<!-- 6. Multiple children -->
<section class="section on-tint" id="multiple-children">
  <div class="wrap what-is-wrap">
    <div data-reveal>
      <span class="eyebrow">One account, every child</span>
      <h2>One account. Every child.</h2>
      <p>Add each child once — their school, class, and meal plan stay separate, but you check on all of them from the same place.</p>
    </div>
    <div class="card" data-reveal style="max-width:480px;">
      <div class="dash-preview-head" style="padding:0 0 14px;">
        <strong style="font-family:'Montserrat',Arial,sans-serif; font-size:15px; color:var(--navy-950);">Your account</strong>
        <span class="sample-tag"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg> Sample view</span>
      </div>
      <div class="student-row">
        <div class="avatar">A</div>
        <div class="student-meta">
          <strong>Ahmed</strong>
          <span>Kuwait English School · Grade 3</span>
        </div>
        <span class="status-line ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M20 6 9 17l-5-5"/></svg> Collected</span>
      </div>
      <div class="student-row">
        <div class="avatar">S</div>
        <div class="student-meta">
          <strong>Sara</strong>
          <span>American Creativity Academy · Grade 1</span>
        </div>
        <span class="status-line pending"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg> Booked</span>
      </div>
    </div>
  </div>
</section>

<!-- 7. App -->
<section class="section" id="app">
  <div class="wrap app-section-wrap">
    <div data-reveal>
      <span class="eyebrow">The Evo Meals app</span>
      <h2>Your child's meals.<br>At your fingertips.</h2>
      <div class="app-flow">
        <span>Menu</span><span class="app-flow-arrow">→</span><span>Choose</span><span class="app-flow-arrow">→</span><span>Pay</span><span class="app-flow-arrow">→</span><span>Collect</span><span class="app-flow-arrow">→</span><span>Notified</span>
      </div>
      <p class="app-download-cta" style="font-weight:700; margin-bottom:10px;">Download the app!</p>
      <div class="store-badges">
        <a href="https://apps.apple.com/us/app/evo-school-meal/id6738001343" class="store-badge" data-magnetic target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zm3.63-3.331c.837-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.817-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701z"/></svg>
          <span>App Store</span>
        </a>
        <a href="https://play.google.com/store/apps/details?id=com.pmg.school" class="store-badge" data-magnetic target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zM13.792 12l3.606-3.583L4.24.936A1.5 1.5 0 0 0 3.312.7L13.792 12zM3.24 23.316a1.5 1.5 0 0 0 .928-.235l12.876-7.462-3.604-3.552L3.24 23.316z"/></svg>
          <span>Google Play</span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- 8. FAQ (short pointer — full FAQ lives on the homepage) -->
<section class="section on-tint" id="faq">
  <div class="wrap" style="text-align:center; max-width:640px;">
    <span class="eyebrow" style="justify-content:center;">Questions</span>
    <h2 style="margin:16px 0 14px;">Have more questions?</h2>
    <p style="color:var(--navy-800); font-size:15.5px; margin-bottom:28px;">Booking, payment, allergies, and cancellations — see the <a href="/#faq">full FAQ</a> on the homepage, or platform-wide capabilities on <a href="/features">Features</a>.</p>
  </div>
</section>

<!-- 9. Registration/login CTA -->
<section class="cta-band">
  <div class="wrap" style="text-align:center;">
    <span class="eyebrow on-dark" style="justify-content:center;">Ready when you are</span>
    <h2 style="margin-top:16px;">Set it up before the next school run.</h2>
    <p style="margin:14px auto 28px;">Takes about two minutes — add a child, pick a plan, book the first meal.</p>
    <div class="hero-actions" style="justify-content:center;">
      <a href="/register" class="btn btn-primary">Create your account</a>
      <a href="/login" class="btn btn-ghost">Log in</a>
    </div>
  </div>
</section>

<%- include('partials/sitefoot') %>

</body>
</html>
