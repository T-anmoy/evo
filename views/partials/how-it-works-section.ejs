<section class="section on-tint" id="how-it-works">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <span class="eyebrow">How the platform works</span>
      <h2>From school programme to your child's hands.</h2>
      <p>How a meal moves through the system, in six steps.</p>
    </div>
    <div class="steps steps-6">
      <div class="step" data-reveal data-reveal-group="platformflow">
        <div class="step-num">School</div>
        <h3>Sets the programme</h3>
        <p>Partners with Evo Meals and onboards its parent community.</p>
      </div>
      <div class="step" data-reveal data-reveal-group="platformflow">
        <div class="step-num">Parent</div>
        <h3>Books &amp; pays</h3>
        <p>Books a plan and pays only for real school days.</p>
      </div>
      <div class="step" data-reveal data-reveal-group="platformflow">
        <div class="step-num">Evo Meals</div>
        <h3>Routes the order</h3>
        <p>Matches each order to the right student and allergy profile.</p>
      </div>
      <div class="step" data-reveal data-reveal-group="platformflow">
        <div class="step-num">Caterer</div>
        <h3>Prepares the meal</h3>
        <p>Sees real orders and prepares exactly what's booked.</p>
      </div>
      <div class="step" data-reveal data-reveal-group="platformflow">
        <div class="step-num">Student</div>
        <h3>Taps &amp; collects</h3>
        <p>One tap at the counter confirms the meal.</p>
      </div>
      <div class="step" data-reveal data-reveal-group="platformflow">
        <div class="step-num">Parent</div>
        <h3>Gets notified</h3>
        <p>You see which meal, and when it was collected.</p>
      </div>
    </div>
  </div>
</section>
