<div class="school-menu-component" data-school-tabs>
  <% if (!groups.length) { %><p class="card"><%= t('schoolMenu.empty') %></p><% } else { %>
    <div class="school-category-tabs" aria-label="<%= t('schoolMenu.categoriesLabel') %>" hidden>
      <% groups.forEach((group, i) => { %><button type="button" class="school-category-tab" id="school-<%= school.id %>-tab-<%= group.category %>" aria-controls="school-<%= school.id %>-panel-<%= group.category %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <% if(group.category==='drink'){ %><path d="M7 8h10l-1 13H8L7 8Zm6 0 2-6h4"/><% } else if(group.category==='snack'){ %><path d="M12 7c-8-5-11 7-5 13 3 2 3-1 5-1s2 3 5 1c6-6 3-18-5-13Zm0 0c0-4 3-5 5-5"/><% } else if(group.category==='side'){ %><path d="M3 10h18c0 7-4 10-9 10S3 17 3 10Zm5-4h8"/><% } else { %><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><% } %>
        </svg><%= t('schoolMenu.categories.'+group.category) %></button><% }) %>
    </div>
    <% groups.forEach(group => { %><section class="school-category-panel" id="school-<%= school.id %>-panel-<%= group.category %>" aria-labelledby="school-<%= school.id %>-heading-<%= group.category %>" tabindex="0">
      <h3 id="school-<%= school.id %>-heading-<%= group.category %>"><%= t('schoolMenu.categories.'+group.category) %></h3>
      <div class="school-dish-grid"><% group.items.forEach(m => { %><%- include('food-card', {m, variant:'school'}) %><% }) %></div>
    </section><% }) %>
  <% } %>
</div>
