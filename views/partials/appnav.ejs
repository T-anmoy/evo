<header class="app-header">
  <div class="wrap app-nav">
    <a href="/dashboard" class="app-logo"><span>Evo <span class="dot">Meals</span></span></a>
    <nav class="app-links">
      <a href="/dashboard" class="<%= active === 'dashboard' ? 'active' : '' %>">Dashboard</a>
      <a href="/students" class="<%= active === 'students' ? 'active' : '' %>">Students</a>
      <a href="/booking" class="<%= active === 'booking' ? 'active' : '' %>">Book a Meal</a>
      <a href="/menu" class="<%= active === 'menu' ? 'active' : '' %>">Menu</a>
      <a href="/history" class="<%= active === 'history' ? 'active' : '' %>">History</a>
      <a href="/staff" class="<%= active === 'staff' ? 'active' : '' %>">Staff</a>
    </nav>
    <div class="app-user">
      <div class="notif-bell-wrap">
        <button type="button" class="notif-bell" id="notifBellBtn" aria-haspopup="true" aria-expanded="false" aria-controls="notifDropdown">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          <% if (typeof unreadNotificationCount !== 'undefined' && unreadNotificationCount > 0) { %><span class="notif-badge"><%= unreadNotificationCount > 9 ? '9+' : unreadNotificationCount %></span><% } %>
        </button>
        <div class="notif-dropdown" id="notifDropdown">
          <div class="notif-dropdown-head">
            <span>Notifications</span>
            <% if (typeof unreadNotificationCount !== 'undefined' && unreadNotificationCount > 0) { %>
              <form method="POST" action="/notifications/read-all">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="notif-markall">Mark all read</button>
              </form>
            <% } %>
          </div>
          <% if (typeof headerNotifications === 'undefined' || headerNotifications.length === 0) { %>
            <div class="notif-empty">No notifications yet.</div>
          <% } else { %>
            <div class="notif-list">
              <% headerNotifications.forEach(n => { %>
                <div class="notif-item <%= n.read ? '' : 'unread' %>">
                  <span class="notif-icon notif-icon-<%= n.type %>">
                    <% if (n.type === 'booking_cancelled') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                    <% } else if (n.type === 'renewal_due') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
                    <% } else { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M20 6 9 17l-5-5"/></svg><% } %>
                  </span>
                  <div class="notif-body">
                    <p><% const nm = splitNotif(n.message); %><% if (nm.lead) { %><strong><%= nm.lead %></strong> <% } %><%= nm.rest %></p>
                    <span class="notif-time"><%= timeAgo(n.createdAt) %></span>
                  </div>
                  <% if (!n.read) { %>
                    <form method="POST" action="/notifications/<%= n.id %>/read" class="notif-read-form">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" aria-label="Mark as read" title="Mark as read"></button>
                    </form>
                  <% } %>
                </div>
              <% }) %>
            </div>
          <% } %>
          <a href="/dashboard#notifications" class="notif-viewall">View all on dashboard</a>
        </div>
      </div>
      <a href="/profile" class="profile-link">Profile</a>
      <a href="/logout" class="btn btn-sm" style="background:rgba(255,255,255,0.1); color:#fff;">Log out</a>
      <button type="button" class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="appLinksMobile">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <span>Menu</span>
      </button>
    </div>
  </div>
  <nav class="app-links-mobile" id="appLinksMobile">
    <div class="mobile-menu-head">
      <span class="mobile-menu-brand">Evo <span class="dot">Meals</span></span>
      <button type="button" class="mobile-menu-close" id="appLinksMobileClose" aria-label="Close menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <a href="/dashboard" class="<%= active === 'dashboard' ? 'active' : '' %>">Dashboard</a>
    <a href="/students" class="<%= active === 'students' ? 'active' : '' %>">Students</a>
    <a href="/booking" class="<%= active === 'booking' ? 'active' : '' %>">Book a Meal</a>
    <a href="/menu" class="<%= active === 'menu' ? 'active' : '' %>">Menu</a>
    <a href="/history" class="<%= active === 'history' ? 'active' : '' %>">History</a>
    <a href="/staff" class="<%= active === 'staff' ? 'active' : '' %>">Staff</a>
    <a href="/profile" class="<%= active === 'profile' ? 'active' : '' %>">Profile</a>
  </nav>
</header>
<script src="/js/nav.js" defer></script>
<script src="/js/notifications.js" defer></script>
