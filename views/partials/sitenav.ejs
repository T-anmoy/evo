<a href="#main-content" class="skip-link"><%= t('a11y.skipToContent') %></a>
<header class="site-header">
  <% const p = locale === 'ar' ? '/ar' : ''; %>
  <div class="wrap-wide site-nav">
    <a href="<%= p %>/" class="site-logo"><span>Evo <span class="dot">Meals</span></span></a>
    <nav class="site-links">
      <a href="<%= p %>/parents" class="<%= active === 'parents' ? 'active' : '' %>" <%= active === 'parents' ? 'aria-current="page"' : '' %>><%= t('nav.forParents') %></a>
      <a href="<%= p %>/schools" class="<%= active === 'schools' ? 'active' : '' %>" <%= active === 'schools' ? 'aria-current="page"' : '' %>><%= t('nav.forSchools') %></a>
      <a href="/caterers" class="<%= active === 'caterers' ? 'active' : '' %>" <%= active === 'caterers' ? 'aria-current="page"' : '' %>><%= t('nav.forCaterers') %></a>
      <a href="<%= p %>/how-it-works" class="<%= active === 'how-it-works' ? 'active' : '' %>" <%= active === 'how-it-works' ? 'aria-current="page"' : '' %>><%= t('nav.howItWorks') %></a>
      <a href="<%= p %>/features" class="<%= active === 'features' ? 'active' : '' %>" <%= active === 'features' ? 'aria-current="page"' : '' %>><%= t('nav.features') %></a>
      <a href="/about" class="<%= active === 'about' ? 'active' : '' %>" <%= active === 'about' ? 'aria-current="page"' : '' %>><%= t('nav.about') %></a>
      <a href="/contact" class="<%= active === 'contact' ? 'active' : '' %>" <%= active === 'contact' ? 'aria-current="page"' : '' %>><%= t('nav.contact') %></a>
    </nav>
    <div class="site-actions">
      <% if (typeof altLocalePath !== 'undefined' && altLocalePath) { %>
        <div class="lang-switch" role="group" aria-label="<%= t('nav.langSwitchLabel') %>">
          <a href="<%= locale === 'en' ? currentPath : altLocalePath %>" lang="en" hreflang="en" aria-current="<%= locale === 'en' ? 'true' : 'false' %>" class="<%= locale === 'en' ? 'is-current' : '' %>">English</a>
          <span class="lang-switch-divider" aria-hidden="true">|</span>
          <a href="<%= locale === 'ar' ? currentPath : altLocalePath %>" lang="ar" hreflang="ar" aria-current="<%= locale === 'ar' ? 'true' : 'false' %>" class="<%= locale === 'ar' ? 'is-current' : '' %>">العربية</a>
        </div>
      <% } %>
      <a href="<%= p %>/login" class="btn btn-ghost btn-sm"><%= t('common.login') %></a>
      <a href="<%= p %>/register" class="btn btn-outline-lime btn-sm"><%= t('common.register') %></a>
      <a href="<%= p === '' ? '/' : p %>#app" class="btn btn-primary btn-sm"><%= t('common.downloadApp') %></a>
      <button type="button" class="nav-toggle" id="siteNavToggle" aria-expanded="false" aria-controls="siteLinksMobile">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <span><%= t('nav.menuToggle') %></span>
      </button>
    </div>
  </div>
  <nav class="site-links-mobile" id="siteLinksMobile">
    <div class="mobile-menu-head">
      <span class="mobile-menu-brand">Evo <span class="dot">Meals</span></span>
      <button type="button" class="mobile-menu-close" id="siteLinksMobileClose" aria-label="<%= t('nav.closeMenu') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
    <a href="<%= p === '' ? '/' : p %>" class="<%= active === 'home' ? 'active' : '' %>" <%= active === 'home' ? 'aria-current="page"' : '' %>><%= t('nav.home') %></a>
    <a href="<%= p %>/parents" class="<%= active === 'parents' ? 'active' : '' %>" <%= active === 'parents' ? 'aria-current="page"' : '' %>><%= t('nav.forParents') %></a>
    <a href="<%= p %>/schools" class="<%= active === 'schools' ? 'active' : '' %>" <%= active === 'schools' ? 'aria-current="page"' : '' %>><%= t('nav.forSchools') %></a>
    <a href="/caterers" class="<%= active === 'caterers' ? 'active' : '' %>" <%= active === 'caterers' ? 'aria-current="page"' : '' %>><%= t('nav.forCaterers') %></a>
    <a href="<%= p %>/how-it-works" class="<%= active === 'how-it-works' ? 'active' : '' %>" <%= active === 'how-it-works' ? 'aria-current="page"' : '' %>><%= t('nav.howItWorks') %></a>
    <a href="<%= p %>/features" class="<%= active === 'features' ? 'active' : '' %>" <%= active === 'features' ? 'aria-current="page"' : '' %>><%= t('nav.features') %></a>
    <a href="/about" class="<%= active === 'about' ? 'active' : '' %>" <%= active === 'about' ? 'aria-current="page"' : '' %>><%= t('nav.aboutFull') %></a>
    <a href="/contact" class="<%= active === 'contact' ? 'active' : '' %>" <%= active === 'contact' ? 'aria-current="page"' : '' %>><%= t('nav.contact') %></a>
    <div class="site-links-mobile-actions">
      <% if (typeof altLocalePath !== 'undefined' && altLocalePath) { %>
        <div class="lang-switch lang-switch-mobile" role="group" aria-label="<%= t('nav.langSwitchLabel') %>">
          <a href="<%= locale === 'en' ? currentPath : altLocalePath %>" lang="en" hreflang="en" aria-current="<%= locale === 'en' ? 'true' : 'false' %>" class="<%= locale === 'en' ? 'is-current' : '' %>">English</a>
          <span class="lang-switch-divider" aria-hidden="true">|</span>
          <a href="<%= locale === 'ar' ? currentPath : altLocalePath %>" lang="ar" hreflang="ar" aria-current="<%= locale === 'ar' ? 'true' : 'false' %>" class="<%= locale === 'ar' ? 'is-current' : '' %>">العربية</a>
        </div>
      <% } %>
      <a href="<%= p %>/login" class="btn btn-ghost"><%= t('common.login') %></a>
      <a href="<%= p %>/register" class="btn btn-outline-lime"><%= t('common.register') %></a>
      <a href="<%= p === '' ? '/' : p %>#app" class="btn btn-primary"><%= t('common.downloadApp') %></a>
    </div>
  </nav>
</header>
<script src="/js/nav.js" defer></script>
