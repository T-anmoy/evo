<div class="collection-example">
  <p class="sample-tag"><%= t('home.collectionProof.sampleTag') %></p>
      <div class="tap-demo">
        <div class="tap-card">
          <div class="chip"></div>
          <div class="card-name"><%= t('collection.student') %></div>
        </div>
        <div class="tap-reader">
          <div class="ripple"></div>
          <div class="ripple delay"></div>
          <div class="reader-ring">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 8.5a8 8 0 0 1 12 0M8.5 11a4.5 4.5 0 0 1 7 0M12 14v.01"/></svg>
          </div>
          <div class="reader-label"><%= t('collection.reader') %></div>
        </div>
        <div class="tap-toast">
          <div class="toast-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" ><path pathLength="1" d="M20 6 9 17l-5-5"/></svg>
          </div>
          <div>
            <div class="toast-title"><%= t('parents.hero.toastTitle') %></div>
            <div class="toast-sub"><bdi><%= t('parents.hero.toastSub') %></bdi></div>
          </div>
        </div>
      </div>

  <button type="button" class="btn btn-outline collection-replay"><%= t('collection.replay') %></button>
  <p class="hint"><%= t('home.collectionProof.intro') %></p>
</div>
