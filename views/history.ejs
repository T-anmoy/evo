<!DOCTYPE html>
<html lang="<%= lang %>" dir="<%= dir %>">
<head><%- include('partials/head', { title: t('meta.history.title') }) %></head>
<body><%- include('partials/appnav', { active: 'history' }) %>
<main class="page" id="main-content">
  <div class="page-head"><span class="eyebrow"><%= t('history.eyebrow') %></span><h1><%= t('history.heading') %></h1><p><%= t('history.intro') %></p></div>
  <div class="card">
    <% if (!subscriptions.length) { %><div class="empty-state"><p><strong><%= t('history.emptyTitle') %></strong><%= t('history.emptyBody') %></p><a href="/booking" class="btn btn-primary"><%= t('history.emptyCta') %></a></div>
    <% } else { %>
      <div class="responsive-records history-records">
        <div class="data-table-view"><table><thead><tr>
          <% ['colStudent','colSchool','colMonths','colMealDays','colTotal','colPaid','colInvoice'].forEach(key=>{ %><th scope="col"><%= t('history.'+key) %></th><% }) %>
        </tr></thead><tbody><% subscriptions.forEach(s=>{ %><tr>
          <td><%= s.student_name %></td><td><%= s.school %></td><td><%= s.months.map(m=>fmtMonth(m.month,locale)).join(' / ') %></td><td><%= s.meal_days %></td><td><bdi><%= fmtKWD(s.total_kwd) %></bdi></td><td><%= fmtDate(s.paid_at) %></td><td><a class="btn btn-outline" href="/history/<%= s.id %>/invoice.pdf"><%= t('subscription.invoice') %></a></td>
        </tr><% }) %></tbody></table></div>
        <div class="data-card-view"><% subscriptions.forEach(s=>{ %><article class="data-card"><h2><%= s.student_name %></h2>
          <dl class="record-details"><% for(const [key,value] of [['colSchool',s.school],['colMonths',s.months.map(m=>fmtMonth(m.month,locale)).join(' / ')],['colMealDays',s.meal_days],['colTotal',fmtKWD(s.total_kwd)],['colPaid',fmtDate(s.paid_at)]]){ %><div><dt><%= t('history.'+key) %></dt><dd><bdi><%= value %></bdi></dd></div><% } %></dl>
          <a class="btn btn-outline" href="/history/<%= s.id %>/invoice.pdf"><%= t('subscription.invoice') %></a>
        </article><% }) %></div>
      </div>
    <% } %>
  </div>
</main><%- include('partials/appfoot') %></body></html>
