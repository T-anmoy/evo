<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
<head>
<%- include('partials/head', { title: t('meta.about.title'), description: t('meta.about.description') }) %>
</head>
<body>

<%- include('partials/sitenav', { active: 'about' }) %>

<section class="hero hero-inner-page">
  <div class="wrap-wide">
    <div class="hero-copy" data-reveal style="max-width:680px;">
      <span class="eyebrow on-dark"><%= t('about.hero.eyebrow') %></span>
      <h1><%= t('about.hero.heading') %></h1>
      <p class="lede"><%= t('about.hero.lede') %></p>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap what-is-wrap">
    <div data-reveal>
      <span class="eyebrow"><%= t('about.story.eyebrow') %></span>
      <h2><%= t('about.story.heading') %></h2>
      <p><%= t('about.story.intro') %></p>
    </div>
    <div class="what-is-pillars">
      <div class="what-is-pillar" data-reveal data-reveal-group="about">
        <span class="what-is-num"><%= t('about.story.pillar1Label') %></span>
        <strong><%= t('about.story.pillar1Body') %></strong>
      </div>
      <div class="what-is-pillar" data-reveal data-reveal-group="about">
        <span class="what-is-num"><%= t('about.story.pillar2Label') %></span>
        <strong><%= t('about.story.pillar2Body') %></strong>
      </div>
      <div class="what-is-pillar" data-reveal data-reveal-group="about">
        <span class="what-is-num"><%= t('about.story.pillar3Label') %></span>
        <strong><%= t('about.story.pillar3Body') %></strong>
      </div>
    </div>
  </div>
</section>

<section class="section on-tint">
  <div class="wrap" style="text-align:center; max-width:640px;">
    <span class="eyebrow" style="justify-content:center;"><%= t('about.cta.eyebrow') %></span>
    <h2 style="margin:16px 0 14px;"><%= t('about.cta.heading') %></h2>
    <p style="color:var(--navy-800); font-size:15.5px; margin-bottom:28px;"><%= t('about.cta.body') %></p>
    <a href="<%= locale === 'ar' ? '/ar/contact' : '/contact' %>" class="btn btn-primary"><%= t('about.cta.button') %></a>
  </div>
</section>

<%- include('partials/sitefoot') %>

</body>
</html>
