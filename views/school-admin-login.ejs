<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
<head>
<%- include('partials/head', { title: t('meta.schoolAdminLogin.title') }) %>
</head>
<body>
  <div class="auth-shell">
    <div class="auth-card">
      <div class="lang-switch" role="group" aria-label="<%= t('nav.langSwitchLabel') %>" style="justify-content:center; margin-bottom:16px;">
        <a href="/locale/en?returnTo=<%= encodeURIComponent(currentPath) %>" lang="en" hreflang="en" aria-current="<%= locale === 'en' ? 'true' : 'false' %>" class="<%= locale === 'en' ? 'is-current' : '' %>">English</a>
        <span class="lang-switch-divider" aria-hidden="true">|</span>
        <a href="/locale/ar?returnTo=<%= encodeURIComponent(currentPath) %>" lang="ar" hreflang="ar" aria-current="<%= locale === 'ar' ? 'true' : 'false' %>" class="<%= locale === 'ar' ? 'is-current' : '' %>">العربية</a>
      </div>
      <div class="logo"><span>Evo <span class="dot">Meals</span></span></div>
      <span class="eyebrow" style="justify-content:center; margin-bottom:10px;"><%= t('schoolAdminLogin.eyebrow') %></span>
      <h1><%= t('schoolAdminLogin.heading') %></h1>
      <p class="sub"><%= t('schoolAdminLogin.subtitle') %></p>

      <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>

      <form method="POST" action="/school-admin/login" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% var sae = (typeof errors !== 'undefined' && errors) ? errors : {}; %>
        <div class="field <%= sae.email ? 'invalid' : '' %>">
          <label for="email"><%= t('schoolAdminLogin.labelEmail') %></label>
          <input type="email" id="email" name="email" inputmode="email" data-validate="email" placeholder="<%= t('schoolAdminLogin.placeholderEmail') %>" required autofocus>
          <div class="field-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= sae.email || t('schoolAdminLogin.errEmail') %></span></div>
        </div>
        <div class="field">
          <label for="password"><%= t('schoolAdminLogin.labelPassword') %></label>
          <input type="password" id="password" name="password" data-validate="required" placeholder="<%= t('schoolAdminLogin.placeholderPassword') %>" required>
          <div class="field-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= t('common.valRequired') %></span></div>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;"><%= t('schoolAdminLogin.submit') %></button>
      </form>

      <!-- Demo credentials (admin@kes.evomeals.demo / admin1234) intentionally
           not shown here — this is a public-facing page. See README for the
           test account. -->
      <div class="auth-foot"><%= t('schoolAdminLogin.notAdminPre') %> <a href="/login" style="color:var(--leaf-dark); font-weight:600;"><%= t('schoolAdminLogin.goToParentLogin') %></a></div>
    </div>
  </div>
</body>
</html>
