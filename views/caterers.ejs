<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
<head>
<%- include('partials/head', { title: t('meta.caterers.title'), description: t('meta.caterers.description') }) %>
</head>
<body>

<%- include('partials/sitenav', { active: 'caterers' }) %>
<main id="main-content" tabindex="-1">

<!-- 1. Hero -->
<section class="hero hero-inner-page">
  <div class="wrap-wide">
    <div class="hero-copy" style="max-width:640px;">
      <span class="eyebrow on-dark"><%= t('caterers.hero.eyebrow') %></span>
      <h1><%= t('caterers.hero.heading') %></h1>
      <p class="lede"><%= t('caterers.hero.lede') %></p>
      <div class="hero-actions">
        <a href="#caterer-form" class="btn btn-light"><%= t('caterers.hero.cta') %></a>
      </div>
    </div>
  </div>
</section>

<section class="section on-tint"><div class="wrap">
  <ol class="parent-journey operational-journey"><% for(let i=1;i<=4;i++){ %><li class="journey-item"><span class="journey-label"><bdi class="journey-number">0<%= i %></bdi><%= t('caterers.flow.title'+i) %></span><p><%= t('caterers.flow.body'+i) %></p></li><% } %></ol>
</div></section>
<!-- 2. Digital order queue (tangible kitchen proof) -->
<section class="section" id="order-queue">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow"><%= t('caterers.orderQueue.eyebrow') %></span>
      <h2><%= t('caterers.orderQueue.heading') %></h2>
      <p><%= t('caterers.orderQueue.intro') %></p>
    </div>
    <div class="card">
      <div class="dash-preview-head" style="padding:0 0 16px;">
        <strong style="font-family:var(--font-heading); font-size:15px; color:var(--forest);"><%= t('caterers.orderQueue.cardHeading') %></strong>
        <span class="sample-tag"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg> <%= t('caterers.orderQueue.sampleTag') %></span>
      </div>
      <% const exampleRows = [
        {student:t('caterers.orderQueue.row1Student'),school:'Kuwait English School',meal:'Arabiatta Chicken Pasta',status:'Collected'},
        {student:t('caterers.orderQueue.row2Student'),school:'American Creativity Academy',meal:'BBQ Chicken & Sweet Potato',status:'Upcoming'},
        {student:t('caterers.orderQueue.row3Student'),school:t('caterers.orderQueue.schoolThird'),meal:'Balsamic Chicken & Beans',status:'Upcoming'}
      ]; %>
      <div class="responsive-records">
        <div class="data-table-view" tabindex="0" role="region" aria-label="<%= t('caterers.orderQueue.cardHeading') %>">
          <table><thead><tr><% ['Student','School','Meal','Status'].forEach(col => { %><th scope="col"><%= t('caterers.orderQueue.col'+col) %></th><% }) %></tr></thead>
          <tbody><% exampleRows.forEach(row => { %><tr><td><bdi><%= row.student %></bdi></td><td><bdi><%= row.school %></bdi></td><td><bdi><%= row.meal %></bdi></td><td><%- include('partials/example-status', {status:row.status}) %></td></tr><% }) %></tbody></table>
        </div>
        <div class="data-card-view"><% exampleRows.forEach(row => { %>
          <article class="data-card"><h3><bdi><%= row.student %></bdi></h3><dl class="record-details">
          <% ['School','Meal'].forEach(col => { %><div><dt><%= t('caterers.orderQueue.col'+col) %></dt><dd><bdi><%= row[col.toLowerCase()] %></bdi></dd></div><% }) %>
          <div><dt><%= t('caterers.orderQueue.colStatus') %></dt><dd><%- include('partials/example-status', {status:row.status}) %></dd></div></dl></article>
        <% }) %></div>
      </div>
    </div>
    <p class="nutrition-more"><%= t('caterers.orderQueue.footnote') %></p>
  </div>
</section>

<section class="section on-tint" id="caterer-form">
  <div class="wrap partner-form-wrap">
    <div class="section-head" style="margin:0;">
      <span class="eyebrow"><%= t('caterers.form.eyebrow') %></span>
      <h2><%= t('caterers.form.heading') %></h2>
      <p><%= t('caterers.form.intro') %></p>
    </div>
    <div class="card">
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success" role="status"><%- include('partials/success-icon') %><span><%= t('caterers.form.successMsg') %></span></div>
      <% } else { %>
        <% var fd = (typeof formData !== 'undefined' && formData) ? formData : {}; var errs = (typeof errors !== 'undefined' && errors) ? errors : {}; %>
        <form method="POST" action="<%= locale === 'ar' ? '/ar/caterers/inquiry' : '/caterers/inquiry' %>" id="catererInquiryForm" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <div class="field <%= errs.organizationName ? 'invalid' : '' %>">
            <label for="catererOrgName"><%= t('caterers.form.labelOrgName') %></label>
            <input type="text" id="catererOrgName" name="organizationName" value="<%= fd.organizationName || '' %>" required data-validate="required" aria-describedby="catererOrgName-error" aria-invalid="<%= (typeof errors !== 'undefined' && errors && errors.organizationName) ? 'true' : 'false' %>">
            <div class="field-error" id="catererOrgName-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= errs.organizationName || t('caterers.form.errOrgName') %></span></div>
          </div>
          <div class="field <%= errs.contactName ? 'invalid' : '' %>">
            <label for="catererContactName"><%= t('caterers.form.labelContactName') %></label>
            <input type="text" id="catererContactName" name="contactName" value="<%= fd.contactName || '' %>" required data-validate="name" aria-describedby="catererContactName-error" aria-invalid="<%= (typeof errors !== 'undefined' && errors && errors.contactName) ? 'true' : 'false' %>">
            <div class="field-error" id="catererContactName-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= errs.contactName || t('caterers.form.errContactName') %></span></div>
          </div>
          <div class="form-row">
            <div class="field <%= errs.email ? 'invalid' : '' %>">
              <label for="catererContactEmail"><%= t('caterers.form.labelEmail') %></label>
              <input type="email" id="catererContactEmail" name="email" value="<%= fd.email || '' %>" inputmode="email" required data-validate="email" aria-describedby="catererContactEmail-error" aria-invalid="<%= (typeof errors !== 'undefined' && errors && errors.email) ? 'true' : 'false' %>">
              <div class="field-error" id="catererContactEmail-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= errs.email || t('caterers.form.errEmail') %></span></div>
            </div>
            <div class="field <%= errs.phone ? 'invalid' : '' %>">
              <label for="catererContactPhone"><%= t('caterers.form.labelPhone') %></label>
              <input type="tel" id="catererContactPhone" name="phone" value="<%= fd.phone || '' %>" inputmode="tel" data-validate="phone" placeholder="+965 ..." aria-describedby="catererContactPhone-error" aria-invalid="<%= (typeof errors !== 'undefined' && errors && errors.phone) ? 'true' : 'false' %>">
              <div class="field-error" id="catererContactPhone-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= errs.phone || t('caterers.form.errPhone') %></span></div>
            </div>
          </div>
          <div class="field">
            <label for="catererScale"><%= t('caterers.form.labelScale') %></label>
            <select id="catererScale" name="scaleInfo">
              <option value="Under 200 meals/day" <%= fd.scaleInfo === 'Under 200 meals/day' ? 'selected' : '' %>><%= t('caterers.form.optUnder200') %></option>
              <option value="200–500 meals/day" <%= fd.scaleInfo === '200–500 meals/day' ? 'selected' : '' %>><%= t('caterers.form.opt200to500') %></option>
              <option value="500–1,500 meals/day" <%= fd.scaleInfo === '500–1,500 meals/day' ? 'selected' : '' %>><%= t('caterers.form.opt500to1500') %></option>
              <option value="1,500+ meals/day" <%= fd.scaleInfo === '1,500+ meals/day' ? 'selected' : '' %>><%= t('caterers.form.opt1500plus') %></option>
            </select>
          </div>
          <div class="field <%= errs.message ? 'invalid' : '' %>">
            <label for="catererMessage"><%= t('caterers.form.labelMessage') %></label>
            <textarea id="catererMessage" name="message" rows="4" required maxlength="2000" data-validate="minlength:10" placeholder="<%= t('caterers.form.placeholderMessage') %>" aria-describedby="catererMessage-error" aria-invalid="<%= (typeof errors !== 'undefined' && errors && errors.message) ? 'true' : 'false' %>"><%= fd.message || '' %></textarea>
            <div class="field-error" id="catererMessage-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= errs.message || t('caterers.form.errMessage') %></span></div>
          </div>
          <button type="submit" class="btn btn-primary" style="width:100%;"><%= t('caterers.form.submit') %></button>
        </form>
      <% } %>
    </div>
  </div>
</section>

</main>
<%- include('partials/sitefoot') %>

</body>
</html>
