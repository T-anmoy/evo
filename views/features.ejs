<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
<head>
<%- include('partials/head', { title: t('meta.features.title'), description: t('meta.features.description') }) %>
</head>
<body>

<%- include('partials/sitenav', { active: 'features' }) %>

<main id="main-content">
<section class="hero hero-inner-page">
  <div class="wrap-wide">
    <div class="hero-copy" data-reveal style="max-width:680px;">
      <span class="eyebrow on-dark"><%= t('features.hero.eyebrow') %></span>
      <h1><%= t('features.hero.heading') %></h1>
      <p class="lede"><%= t('features.hero.lede') %></p>
    </div>
  </div>
</section>

<%- include('partials/features-section') %>

<section class="cta-band">
  <div class="wrap" style="text-align:center;">
    <span class="eyebrow on-dark" style="justify-content:center;"><%= t('features.cta.eyebrow') %></span>
    <h2 style="margin-top:16px;"><%= t('features.cta.heading') %></h2>
    <p style="margin:14px auto 28px;"><%= t('features.cta.body') %></p>
    <a href="<%= locale === 'ar' ? '/ar/register' : '/register' %>" class="btn btn-school-yellow"><%= t('common.createAccount') %></a>
  </div>
</section>
</main>

<%- include('partials/sitefoot') %>

</body>
</html>
