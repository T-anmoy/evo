<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
<head>
<%- include('partials/head', { title: t('meta.dashboard.title') }) %>
</head>
<body>
<%- include('partials/appnav', { active: 'dashboard' }) %>

<main class="page dashboard-page" id="main-content">
  <div class="page-head">
    <span class="eyebrow"><%= t('dashboard.eyebrow') %></span>
    <h1><bdi><%= parent.name %></bdi></h1>
    <p><%= t('dashboard.intro') %></p>
  </div>

  <div class="dashboard-overview">
  <section class="card dash-today" aria-labelledby="todays-status-heading">
    <h2 class="dash-section-title" id="todays-status-heading"><%= t('dashboard.todaysStatusHeading') %></h2>
    <% if (studentStatus.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 9a7 7 0 0 1 14 0"/></svg></div>
        <p><strong><%= t('dashboard.emptyNoStudentsTitle') %></strong><%= t(features.showCollection ? 'dashboard.emptyNoStudentsBody' : 'dashboard.emptyNoStudentsBodyWithoutCollection') %></p>
        <a href="/students" class="btn btn-primary btn-sm" style="margin-top:16px;"><%= t('dashboard.emptyNoStudentsCta') %></a>
      </div>
    <% } else { %>
      <% studentStatus.forEach(({student, booking, menuItem}) => { %>
        <div class="student-row">
          <div class="avatar"><%= student.name.charAt(0) %></div>
          <div class="student-meta">
            <strong><bdi><%= student.name %></bdi></strong>
            <% if (booking && menuItem) { %>
              <span class="student-meal"><bdi><%= menuItem.name %></bdi></span>
            <% } %>
            <span><bdi><%= student.school %></bdi> · <%= t("students.classes." + student.class) %></span>
          </div>
          <% if (features.showCollection && booking && booking.status === 'collected') { %>
            <span class="status-line ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M20 6 9 17l-5-5"/></svg> <%- t('dashboard.statusCollectedAt', { time: `<bdi>${fmtTime(booking.collectedAt)}</bdi>` }) %></span>
          <% } else if (booking && (booking.status === 'upcoming' || !features.showCollection)) { %>
            <span class="status-line pending"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg> <%= t(features.showCollection ? 'dashboard.statusPending' : 'dashboard.statusPendingWithoutCollection') %></span>
          <% } else { %>
            <span class="status-line none"><%= t('dashboard.statusNone') %></span>
          <% } %>
        </div>
      <% }) %>
    <% } %>
  </section>

  <section class="card dash-actions"><h2 class="dash-section-title"><%= t('dashboard.actionsHeading') %></h2>
    <% students.forEach(student=>{ %><div class="card renewal-card"><strong><bdi><%= student.name %></bdi></strong><a class="btn btn-primary" href="/booking/new?student=<%= student.id %>"><%= t('subscription.bookMore') %></a></div><% }) %>
  </section>

  </div>

  <% if (activeSubscriptionPeriods.length > 0) { %>
    <section class="card" style="margin-bottom:24px;" aria-labelledby="current-period-heading">
      <h2 class="dash-section-title" id="current-period-heading"><%= activeSubscriptionPeriods.length === 1 ? t('dashboard.currentPeriodHeading') : t('dashboard.currentPeriodHeadingPlural') %></h2>
      <% activeSubscriptionPeriods.forEach(p => { %>
        <div class="period-row">
          <div class="period-meta">
            <strong><%= p.studentName %></strong>
            <span><bdi><%= fmtDate(p.startDate) %> – <%= fmtDate(p.endDate) %></bdi></span>
          </div>
          <div class="period-figures">
            <span class="data-num"><bdi><%= t('dashboard.periodDays', { days: p.days, unit: t('dashboard.' + (p.days === 1 ? 'schoolDayUnitOne' : 'schoolDayUnitOther')) }) %></bdi></span>
            <strong class="data-num"><%- t('dashboard.periodPaid', { amount: `<bdi>${fmtKWD(p.totalKWD)}</bdi>` }) %></strong>
          </div>
        </div>
      <% }) %>
    </section>
  <% } %>

  <div class="card" id="notifications" style="margin-top:24px;">
    <div class="dash-card-head">
      <h2 class="dash-section-title" style="margin-bottom:0;"><%= t('dashboard.notificationsHeading') %></h2>
      <% if (unreadNotificationCount > 0) { %>
        <form method="POST" action="/notifications/read-all">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="notif-markall"><%= t('dashboard.markAllRead') %></button>
        </form>
      <% } %>
    </div>
    <% if (!notifications || notifications.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg></div>
        <p><strong><%= t('dashboard.emptyNotificationsTitle') %></strong><%= t(features.showCollection ? 'dashboard.emptyNotificationsBody' : 'dashboard.emptyNotificationsBodyWithoutCollection') %></p>
      </div>
    <% } else { %>
      <div class="dash-notif-list">
        <% notifications.forEach(n => { %>
          <div class="dash-notif-item <%= n.read ? '' : 'unread' %>">
            <span class="notif-icon notif-icon-<%= n.type %>">
              <% if (n.type === 'booking_cancelled') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
              <% } else if (n.type === 'renewal_due') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
              <% } else { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M20 6 9 17l-5-5"/></svg><% } %>
            </span>
            <div class="notif-body">
              <p><% const nm = splitNotif(notifMessage(n, t, fmtKWD)); %><% if (nm.lead) { %><strong><%= nm.lead %></strong> <% } %><%= nm.rest %></p>
              <span class="notif-time"><bdi><%= timeAgo(n.createdAt, t) %></bdi></span>
            </div>
            <% if (!n.read) { %>
              <form method="POST" action="/notifications/<%= n.id %>/read" class="notif-read-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" aria-label="<%= t('appNav.markAsRead') %>" title="<%= t('appNav.markAsRead') %>"></button>
              </form>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <p class="dash-account-summary">
    <bdi><%= t('dashboard.summaryChildren', { count: students.length, unit: t('dashboard.' + (students.length === 1 ? 'summaryChildUnitOne' : 'summaryChildUnitOther')) }) %></bdi>
    ·
    <bdi><%= t('dashboard.summaryBookings', { count: activeBookingCount, unit: t('dashboard.' + (activeBookingCount === 1 ? 'summaryBookingUnitOne' : 'summaryBookingUnitOther')) }) %></bdi>
  </p>

  <div class="grid-2 dashboard-shortcuts" style="margin-top:24px;">
    <div class="card">
      <h3 style="font-size:15px; margin-bottom:10px;"><%= t('dashboard.bookMealTitle') %></h3>
      <p style="font-size:13.5px; color:var(--muted); margin-bottom:16px;"><%= t('dashboard.bookMealBody') %></p>
      <a href="/booking" class="btn btn-primary btn-sm"><%= t('dashboard.bookMealCta') %></a>
    </div>
    <div class="card">
      <h3 style="font-size:15px; margin-bottom:10px;"><%= t('dashboard.historyTitle') %></h3>
      <p style="font-size:13.5px; color:var(--muted); margin-bottom:16px;"><%= t('dashboard.historyBody') %></p>
      <a href="/history" class="btn btn-outline btn-sm"><%= t('dashboard.historyCta') %></a>
    </div>
  </div>
</main>

<%- include('partials/appfoot') %>
</body>
</html>
