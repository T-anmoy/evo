<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' ? lang : 'en' %>" dir="<%= typeof dir !== 'undefined' ? dir : 'ltr' %>">
<head>
<%- include('partials/head', { title: t('meta.dashboard.title') }) %>
</head>
<body>
<%- include('partials/appnav', { active: 'dashboard' }) %>

<main class="page" id="main-content">
  <div class="page-head">
    <span class="eyebrow"><%= t('dashboard.eyebrow') %></span>
    <h1><%= parent.name %></h1>
    <p><%= t('dashboard.intro') %></p>
  </div>

  <% if (renewed) { %><div class="alert alert-success"><%- include('partials/success-icon') %><span><%= t('dashboard.renewedAlert') %></span></div><% } %>
  <% if (typeof norenewaldays !== 'undefined' && norenewaldays) { %><div class="alert alert-error"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg><span><%= t('dashboard.noRenewalDaysAlert') %></span></div><% } %>

  <% if (renewalCandidates && renewalCandidates.length > 0) { %>
    <% renewalCandidates.forEach(rc => { %>
      <div class="card renewal-card" data-reveal>
        <div class="renewal-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></div>
        <div class="renewal-body">
          <strong><%= t('dashboard.renewalEndsIn', { name: rc.studentName, days: rc.daysLeft, unit: t('dashboard.' + (rc.daysLeft === 1 ? 'dayUnitOne' : 'dayUnitOther')) }) %></strong>
          <span><%= t('dashboard.renewalBody', { meal: rc.mealName }) %></span>
        </div>
        <form method="POST" action="/booking/<%= rc.bookingId %>/renew">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn btn-primary btn-sm"><%= t('dashboard.renewButton') %></button>
        </form>
      </div>
    <% }) %>
  <% } %>

  <% if (typeof lastBooking !== 'undefined' && lastBooking) { %>
    <div class="card quick-rebook-card" data-reveal>
      <div class="quick-rebook-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8 12 4l8 4-8 4-8-4Z"/><path d="M4 8v8l8 4 8-4V8"/></svg></div>
      <div class="quick-rebook-body">
        <strong><%= t('dashboard.quickRebookTitle') %></strong>
        <span><%= t('dashboard.quickRebookBody', { meal: lastBooking.mealName, name: lastBooking.studentName }) %></span>
      </div>
      <a href="/booking?rebook=<%= lastBooking.id %>" class="btn btn-primary"><%= t('dashboard.quickRebookCta') %></a>
    </div>
  <% } %>

  <div class="grid-3" style="margin-bottom:28px;">
    <div class="stat leaf" data-reveal data-reveal-group="stats">
      <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></div>
      <div class="label"><%= t('dashboard.statActiveSubs') %></div>
      <div class="value leaf data-num" data-countup="<%= activeSubscriptionPeriods.length %>">0</div>
    </div>
    <div class="stat" data-reveal data-reveal-group="stats">
      <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 9a7 7 0 0 1 14 0"/></svg></div>
      <div class="label"><%= t('dashboard.statChildrenRegistered') %></div>
      <div class="value data-num" data-countup="<%= students.length %>">0</div>
    </div>
    <div class="stat" data-reveal data-reveal-group="stats">
      <div class="stat-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8.5a8 8 0 0 1 12 0M8.5 11a4.5 4.5 0 0 1 7 0M12 14v.01"/></svg></div>
      <div class="label"><%= t('dashboard.statActiveBookings') %></div>
      <div class="value data-num" data-countup="<%= activeBookingCount %>">0</div>
    </div>
  </div>

  <% if (activeSubscriptionPeriods.length > 0) { %>
    <div class="card" style="margin-bottom:24px;" data-reveal>
      <h3 style="font-size:15px; margin-bottom:16px;"><%= activeSubscriptionPeriods.length === 1 ? t('dashboard.currentPeriodHeading') : t('dashboard.currentPeriodHeadingPlural') %></h3>
      <% activeSubscriptionPeriods.forEach(p => { %>
        <div class="period-row">
          <div class="period-meta">
            <strong><%= p.studentName %></strong>
            <span><%= p.mealName %> · <bdi><%= fmtDate(p.startDate) %> – <%= fmtDate(p.endDate) %></bdi></span>
          </div>
          <div class="period-figures">
            <span class="data-num"><bdi><%= t('dashboard.periodDays', { days: p.days, unit: t('dashboard.' + (p.days === 1 ? 'schoolDayUnitOne' : 'schoolDayUnitOther')) }) %></bdi></span>
            <strong class="data-num"><%- t('dashboard.periodPaid', { amount: `<bdi>${fmtKWD(p.totalKWD)}</bdi>` }) %></strong>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <div class="card" data-reveal>
    <h3 style="font-size:15px; margin-bottom:16px;"><%= t('dashboard.todaysStatusHeading') %></h3>
    <% if (studentStatus.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm-7 9a7 7 0 0 1 14 0"/></svg></div>
        <p><strong><%= t('dashboard.emptyNoStudentsTitle') %></strong><%= t('dashboard.emptyNoStudentsBody') %></p>
        <a href="/students" class="btn btn-primary btn-sm" style="margin-top:16px;"><%= t('dashboard.emptyNoStudentsCta') %></a>
      </div>
    <% } else { %>
      <% studentStatus.forEach(({student, booking}) => { %>
        <div class="student-row">
          <div class="avatar"><%= student.name.charAt(0) %></div>
          <div class="student-meta">
            <strong><%= student.name %></strong>
            <span><%= student.school %> · <%= student.class %></span>
          </div>
          <% if (booking && booking.status === 'collected') { %>
            <span class="status-line ok"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M20 6 9 17l-5-5"/></svg> <%- t('dashboard.statusCollectedAt', { time: `<bdi>${fmtTime(booking.collectedAt)}</bdi>` }) %></span>
          <% } else if (booking && booking.status === 'upcoming') { %>
            <span class="status-line pending"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg> <%= t('dashboard.statusPending') %></span>
          <% } else { %>
            <span class="status-line none"><%= t('dashboard.statusNone') %></span>
          <% } %>
        </div>
      <% }) %>
    <% } %>
  </div>

  <div class="card" id="notifications" style="margin-top:24px;" data-reveal>
    <div class="dash-card-head">
      <h3 style="font-size:15px;"><%= t('dashboard.notificationsHeading') %></h3>
      <% if (unreadNotificationCount > 0) { %>
        <form method="POST" action="/notifications/read-all">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="notif-markall"><%= t('dashboard.markAllRead') %></button>
        </form>
      <% } %>
    </div>
    <% if (!notifications || notifications.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg></div>
        <p><strong><%= t('dashboard.emptyNotificationsTitle') %></strong><%= t('dashboard.emptyNotificationsBody') %></p>
      </div>
    <% } else { %>
      <div class="dash-notif-list">
        <% notifications.forEach(n => { %>
          <div class="dash-notif-item <%= n.read ? '' : 'unread' %>">
            <span class="notif-icon notif-icon-<%= n.type %>">
              <% if (n.type === 'booking_cancelled') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
              <% } else if (n.type === 'renewal_due') { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
              <% } else { %><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M20 6 9 17l-5-5"/></svg><% } %>
            </span>
            <div class="notif-body">
              <p><% const nm = splitNotif(notifMessage(n, t, fmtKWD)); %><% if (nm.lead) { %><strong><%= nm.lead %></strong> <% } %><%= nm.rest %></p>
              <span class="notif-time"><bdi><%= timeAgo(n.createdAt, t) %></bdi></span>
            </div>
            <% if (!n.read) { %>
              <form method="POST" action="/notifications/<%= n.id %>/read" class="notif-read-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" aria-label="<%= t('appNav.markAsRead') %>" title="<%= t('appNav.markAsRead') %>"></button>
              </form>
            <% } %>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div class="grid-2" style="margin-top:24px;">
    <div class="card" data-reveal>
      <h3 style="font-size:15px; margin-bottom:10px;"><%= t('dashboard.bookMealTitle') %></h3>
      <p style="font-size:13.5px; color:var(--muted); margin-bottom:16px;"><%= t('dashboard.bookMealBody') %></p>
      <a href="/booking" class="btn btn-primary btn-sm"><%= t('dashboard.bookMealCta') %></a>
    </div>
    <div class="card" data-reveal>
      <h3 style="font-size:15px; margin-bottom:10px;"><%= t('dashboard.historyTitle') %></h3>
      <p style="font-size:13.5px; color:var(--muted); margin-bottom:16px;"><%= t('dashboard.historyBody') %></p>
      <a href="/history" class="btn btn-outline btn-sm"><%= t('dashboard.historyCta') %></a>
    </div>
  </div>
</main>

<%- include('partials/appfoot') %>
</body>
</html>
